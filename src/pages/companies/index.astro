---
// Companies index (Task 7.2 / 需求 1): list ONLY published companies that have
// at least one published drug, in a stable order (by `order`, then name). There
// is no "in preparation" placeholder — a company with no published drug is not
// listed at all. When none qualify, the empty-state message is shown.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  publishedOnly,
  sortCompanies,
  companiesWithPublishedDrugs,
  slugOf,
  toCompanyUrl,
} from '../../lib/catalog';
import { t } from '../../lib/i18n';

const locale = 'zh';

const drugs = await getCollection('drugs');
const withPublishedDrugs = companiesWithPublishedDrugs(drugs);
const companies = sortCompanies(publishedOnly(await getCollection('companies'))).filter(
  (company) => withPublishedDrugs.has(slugOf(company)),
);
---

<BaseLayout title={t(locale, 'nav.companies')} locale={locale}>
  <h1>{t(locale, 'nav.companies')}</h1>

  {
    companies.length === 0 ? (
      <p class="empty-state">{t(locale, 'company.empty')}</p>
    ) : (
      <ul class="company-list">
        {companies.map((company) => (
          <li class="company-list__item">
            <a class="company-list__link" href={toCompanyUrl(slugOf(company))}>
              {company.data.name}
            </a>
            {company.data.summary && (
              <p class="company-list__summary">{company.data.summary}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
