---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
import { getCollection } from 'astro:content';
import {
  classAnchor,
  companyRefOf,
  groupByTherapeuticArea,
  productNameOf,
  slugOf,
  sortByPopularity,
  toDrugUrl,
} from '../lib/catalog';
import { t } from '../lib/i18n';

const locale = 'zh';
const allDrugs = await getCollection('drugs');
const sortedByPopularity = sortByPopularity(allDrugs);
const popular = [
  ...sortedByPopularity.filter((drug) => companyRefOf(drug) === 'beigene'),
  ...sortedByPopularity.filter((drug) => companyRefOf(drug) !== 'beigene'),
].slice(0, 8);
const areaGroups = groupByTherapeuticArea(allDrugs);
---

<BaseLayout title={t(locale, 'site.title')} description={t(locale, 'site.tagline')} locale={locale}>
  <section class="hero" aria-labelledby="home-title">
    <h1 id="home-title">{t(locale, 'site.title')}</h1>
    <p class="hero__tagline">{t(locale, 'site.tagline')}</p>
  </section>

  <section id="search" class="home-search" aria-labelledby="search-title">
    <h2 id="search-title">{t(locale, 'nav.search')}</h2>
    <Search locale={locale} />
  </section>

  {popular.length > 0 && (
    <section class="featured" aria-labelledby="popular-title">
      <h2 id="popular-title">{t(locale, 'home.popularTitle')}</h2>
      <p class="featured__lead">{t(locale, 'home.popularLead')}</p>
      <ul class="featured__list">
        {popular.map((drug) => (
          <li>
            <a class="card featured__card" href={toDrugUrl(slugOf(drug))}>
              <span class="featured__name">{productNameOf(drug.data)}</span>
              <span class="featured__generic">
                <span class="featured__generic-label">{t(locale, 'drug.genericName')}</span>
                <strong>{drug.data.genericName}</strong>
                {drug.data.genericNameEn && <span lang="en">{drug.data.genericNameEn}</span>}
              </span>
              {drug.data.drugClass && <span class="chip">{drug.data.drugClass}</span>}
              <span class="featured__summary">
                {drug.data.mechanism.analogy ?? drug.data.mechanism.simple}
              </span>
              <span class="featured__cta">{t(locale, 'home.viewMechanism')} &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {areaGroups.length > 0 && (
    <section class="by-class" aria-labelledby="by-class-title">
      <h2 id="by-class-title">{t(locale, 'home.byClassTitle')}</h2>
      <p class="by-class__lead">{t(locale, 'home.byClassLead')}</p>
      <div class="by-class__areas">
        {areaGroups.map((group, index) => (
          <details class="area" open={index === 0}>
            <summary class="area__summary">
              <span class="area__name">{group.area}</span>
              <span class="area__count">{group.classes.length} 类 · {group.drugCount} 款药物</span>
            </summary>
            <ul class="area__list">
              {group.classes.map((classGroup) => (
                <li>
                  <a
                    class="chip area__chip"
                    href={`/drugs/#${classAnchor(classGroup.drugClass)}`}
                  >
                    <span class="area__chip-name">{classGroup.drugClass}</span>
                    <span class="area__chip-num">{classGroup.drugs.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
      <p class="by-class__all">
        <a href="/drugs/">{t(locale, 'home.viewAllDrugs')} &rarr;</a>
      </p>
    </section>
  )}

  <nav class="home-entries" aria-label={t(locale, 'home.browseTitle')}>
    <h2>{t(locale, 'home.browseTitle')}</h2>
    <ul>
      <li>
        <a class="card" href="/companies/">
          <span class="home-entries__title">{t(locale, 'nav.companies')}</span>
          <span class="home-entries__desc">{t(locale, 'home.companiesEntry')}</span>
        </a>
      </li>
      <li>
        <a class="card" href="/about/">
          <span class="home-entries__title">{t(locale, 'nav.about')}</span>
          <span class="home-entries__desc">{t(locale, 'home.aboutEntry')}</span>
        </a>
      </li>
    </ul>
  </nav>
</BaseLayout>
