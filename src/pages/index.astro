---
// Home (需求 9 / 1): hero + prominent search, then two drug-first browse
// sections — "热门药物" (most-prominent published drugs; BeiGene's products
// pinned first, then by popularity) and "按作用机制浏览" (published drug classes
// grouped by therapeutic area; each class chip jumps to that class's section on
// the all-drugs index) — followed by the smaller company/about entry cards.
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
import { getCollection } from 'astro:content';
import {
  sortByPopularity,
  groupByTherapeuticArea,
  classAnchor,
  companyRefOf,
  slugOf,
  toDrugUrl,
} from '../lib/catalog';
import { t } from '../lib/i18n';

const locale = 'zh';

const allDrugs = await getCollection('drugs');
// Up to 8 most-prominent published drugs, with BeiGene's products pinned first.
const sortedByPopularity = sortByPopularity(allDrugs);
const popular = [
  ...sortedByPopularity.filter((drug) => companyRefOf(drug) === 'beigene'),
  ...sortedByPopularity.filter((drug) => companyRefOf(drug) !== 'beigene'),
].slice(0, 8);
// Published drug classes grouped by therapeutic area for the browse section.
const areaGroups = groupByTherapeuticArea(allDrugs);
---

<BaseLayout title={t(locale, 'site.title')} locale={locale}>
  <section class="hero">
    <h1>{t(locale, 'site.title')}</h1>
    <p class="hero__tagline">{t(locale, 'site.tagline')}</p>
  </section>

  <section id="search" class="home-search" aria-label={t(locale, 'nav.search')}>
    <h2>{t(locale, 'nav.search')}</h2>
    <Search locale={locale} />
  </section>

  {
    popular.length > 0 && (
      <section class="featured" aria-label={t(locale, 'home.popularTitle')}>
        <h2>{t(locale, 'home.popularTitle')}</h2>
        <p class="featured__lead">{t(locale, 'home.popularLead')}</p>
        <ul class="featured__list">
          {popular.map((drug) => (
            <li>
              <a class="card featured__card" href={toDrugUrl(slugOf(drug))}>
                <span class="featured__name">{drug.data.genericName}</span>
                {drug.data.brandName && (
                  <span class="featured__brand">{drug.data.brandName}</span>
                )}
                {drug.data.drugClass && <span class="chip">{drug.data.drugClass}</span>}
                {drug.data.summary && (
                  <span class="featured__summary">{drug.data.summary}</span>
                )}
                <span class="featured__cta">{t(locale, 'home.viewMechanism')} &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    areaGroups.length > 0 && (
      <section class="by-class" aria-label={t(locale, 'home.byClassTitle')}>
        <h2>{t(locale, 'home.byClassTitle')}</h2>
        <p class="by-class__lead">{t(locale, 'home.byClassLead')}</p>
        <div class="by-class__areas">
          {areaGroups.map((group, index) => (
            <details class="area" open={index === 0}>
              <summary class="area__summary">
                <span class="area__name">{group.area}</span>
                <span class="area__count">{group.classes.length} 类 · {group.drugCount} 种</span>
              </summary>
              <ul class="area__list">
                {group.classes.map((classGroup) => (
                  <li>
                    <a
                      class="chip area__chip"
                      href={`/drugs#${classAnchor(classGroup.drugClass)}`}
                    >
                      <span class="area__chip-name">{classGroup.drugClass}</span>
                      <span class="area__chip-num">{classGroup.drugs.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
        <p class="by-class__all">
          <a href="/drugs">{t(locale, 'home.viewAllDrugs')} &rarr;</a>
        </p>
      </section>
    )
  }

  <nav class="home-entries" aria-label={t(locale, 'home.browseTitle')}>
    <h2>{t(locale, 'home.browseTitle')}</h2>
    <ul>
      <li>
        <a class="card" href="/companies">
          <span class="home-entries__title">{t(locale, 'nav.companies')}</span>
          <span class="home-entries__desc">{t(locale, 'home.companiesEntry')}</span>
        </a>
      </li>
      <li>
        <a class="card" href="/about">
          <span class="home-entries__title">{t(locale, 'nav.about')}</span>
          <span class="home-entries__desc">{t(locale, 'home.aboutEntry')}</span>
        </a>
      </li>
    </ul>
  </nav>
</BaseLayout>
