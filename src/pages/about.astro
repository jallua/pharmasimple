---
// About (Task 7.5 / 需求 7): content methodology + a full, prominent disclaimer.
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { t } from '../lib/i18n';

const locale = 'zh';
---

<BaseLayout title={t(locale, 'about.title')} locale={locale}>
  <div class="reading">
    <h1>{t(locale, 'about.title')}</h1>

    <section aria-label={t(locale, 'about.methodologyTitle')}>
      <h2>{t(locale, 'about.methodologyTitle')}</h2>
      <p>{t(locale, 'about.methodologyBody')}</p>
    </section>

    <section aria-label={t(locale, 'about.sourcesTitle')}>
      <h2>{t(locale, 'about.sourcesTitle')}</h2>
      <p>{t(locale, 'about.sourcesBody')}</p>
    </section>

    <Disclaimer locale={locale} variant="prominent" />
  </div>
</BaseLayout>
