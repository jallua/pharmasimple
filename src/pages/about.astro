---
// About: what the site is, how to read a drug page, content methodology,
// coverage stats, authoritative sources, and a prominent disclaimer.
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getCollection } from 'astro:content';
import { companiesWithPublishedDrugs, publishedOnly, slugOf } from '../lib/catalog';
import { t } from '../lib/i18n';

const locale = 'zh';
const companies = publishedOnly(await getCollection('companies'));
const drugs = publishedOnly(await getCollection('drugs'));
const withPublishedDrugs = companiesWithPublishedDrugs(drugs);
const companyCount = companies.filter((company) => withPublishedDrugs.has(slugOf(company))).length;
const drugCount = drugs.length;

const guide = [
  t(locale, 'about.guideAnalogy'),
  t(locale, 'about.guideSimple'),
  t(locale, 'about.guideAdvanced'),
  t(locale, 'about.guideAnimation'),
  t(locale, 'about.guideIndications'),
  t(locale, 'about.guideTarget'),
  t(locale, 'about.guideCitations'),
];
const methodPoints = [
  t(locale, 'about.methodPoint1'),
  t(locale, 'about.methodPoint2'),
  t(locale, 'about.methodPoint3'),
  t(locale, 'about.methodPoint4'),
];
const sources = [
  'FDA（美国）',
  'NMPA（中国）',
  'EMA（欧盟）',
  'PMDA（日本）',
  '美国国家癌症研究所（NCI）',
  '美国国家生物技术信息中心（NCBI）',
  'DailyMed（美国官方药品标签）',
  'MedlinePlus（美国国家医学图书馆）',
];
---

<BaseLayout title={t(locale, 'about.title')} description={t(locale, 'meta.aboutDesc')} locale={locale}>
  <div class="reading">
    <h1>{t(locale, 'about.title')}</h1>
    <p class="about-lead">{t(locale, 'about.intro')}</p>

    <section aria-label={t(locale, 'about.companyProfilesTitle')}>
      <h2>{t(locale, 'about.companyProfilesTitle')}</h2>
      <p>{t(locale, 'about.companyProfilesLead')}</p>
    </section>

    <section aria-label={t(locale, 'about.guideTitle')}>
      <h2>{t(locale, 'about.guideTitle')}</h2>
      <p>{t(locale, 'about.guideLead')}</p>
      <ul class="about-guide">
        {guide.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section aria-label={t(locale, 'about.methodologyTitle')}>
      <h2>{t(locale, 'about.methodologyTitle')}</h2>
      <p>{t(locale, 'about.methodologyLead')}</p>
      <ul class="about-points">
        {methodPoints.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section aria-label={t(locale, 'about.coverageTitle')}>
      <h2>{t(locale, 'about.coverageTitle')}</h2>
      <ul class="about-stats">
        <li class="about-stat">
          <span class="about-stat__num">{companyCount}</span>
          <span class="about-stat__label">{t(locale, 'about.coverageUnitCompanies')}</span>
        </li>
        <li class="about-stat">
          <span class="about-stat__num">{drugCount}</span>
          <span class="about-stat__label">{t(locale, 'about.coverageUnitDrugs')}</span>
        </li>
      </ul>
    </section>

    <section aria-label={t(locale, 'about.sourcesTitle')}>
      <h2>{t(locale, 'about.sourcesTitle')}</h2>
      <p>{t(locale, 'about.sourcesLead')}</p>
      <ul class="about-sources">
        {sources.map((s) => (
          <li class="chip">{s}</li>
        ))}
      </ul>
      <p class="about-note">{t(locale, 'about.sourcesNote')}</p>
    </section>

    <Disclaimer locale={locale} variant="prominent" />
  </div>
</BaseLayout>
