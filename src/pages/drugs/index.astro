---
// Drugs index (需求 1 / 9): every PUBLISHED drug, grouped by drug class. Each
// group shows its class name as a subheading and its drugs as cards linking to
// the drug's mechanism page. The grouping + ordering (published-only, P1;
// popularity within each group; most-prominent class first) come from the pure
// `groupByDrugClass` helper. With no published drugs the page shows a friendly
// empty state.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { groupByDrugClass, slugOf, toDrugUrl, classAnchor } from '../../lib/catalog';
import { t } from '../../lib/i18n';

const locale = 'zh';

const groups = groupByDrugClass(await getCollection('drugs'));
---

<BaseLayout title={t(locale, 'drugs.indexTitle')} locale={locale}>
  <h1>{t(locale, 'drugs.indexTitle')}</h1>
  <p class="drugs-index__lead">{t(locale, 'drugs.indexLead')}</p>

  {
    groups.length === 0 ? (
      <p class="empty-state">{t(locale, 'drugs.empty')}</p>
    ) : (
      groups.map((group) => (
        <section class="drug-class-group" id={classAnchor(group.drugClass)} aria-label={group.drugClass}>
          <h2 class="drug-class-group__title">{group.drugClass}</h2>
          <ul class="drug-list">
            {group.drugs.map((drug) => (
              <li class="drug-list__item">
                <a href={toDrugUrl(slugOf(drug))}>
                  {drug.data.genericName}
                  {drug.data.brandName ? ` (${drug.data.brandName})` : ''}
                </a>
                {drug.data.summary && <p class="drug-list__summary">{drug.data.summary}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
