---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  companyDisplayNameOf,
  companyNameParts,
  productNameOf,
  publishedDrugDetailPaths,
  slugOf,
  toCompanyUrl,
} from '../../lib/catalog';
import MechanismLayers from '../../components/MechanismLayers.astro';
import MechanismMedia from '../../components/MechanismMedia.astro';
import Citations from '../../components/Citations.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t } from '../../lib/i18n';

export async function getStaticPaths() {
  const drugs = await getCollection('drugs');
  return publishedDrugDetailPaths(drugs);
}

const locale = 'zh';
const { drug } = Astro.props;
const { data } = drug;
const productName = productNameOf(data);
const mechanismHeading = t(locale, 'mechanism.heading');
const mediaHeading = t(locale, 'mechanism.mediaHeading');

const companyRefValue = data.company as unknown;
const companyRefId =
  typeof companyRefValue === 'string'
    ? companyRefValue
    : ((companyRefValue as { id?: string; slug?: string })?.id ??
       (companyRefValue as { id?: string; slug?: string })?.slug ??
       '');

const companies = await getCollection('companies');
const companyEntry = companies.find((company) => slugOf(company) === companyRefId);
const companyName = companyEntry ? companyNameParts(companyEntry.data).primary : undefined;
const companyDisplayName = companyEntry ? companyDisplayNameOf(companyEntry.data) : undefined;

const crumbs = [
  { label: t(locale, 'nav.home'), href: '/' },
  { label: t(locale, 'nav.companies'), href: '/companies/' },
  ...(companyRefId && companyName
    ? [{ label: companyName, href: toCompanyUrl(companyRefId) }]
    : []),
  { label: productName },
];

const siteBase = (Astro.site?.href ?? 'https://dongyaojun.com/').replace(/\/+$/, '');
const drugUrl = `${siteBase}/drugs/${slugOf(drug)}/`;
const altNames = [data.genericName, data.genericNameEn].filter(
  (name): name is string => Boolean(name && name !== productName),
);
const dateModified = data.updatedDate
  ? new Date(data.updatedDate).toISOString().slice(0, 10)
  : undefined;
const jsonLd = [
  {
    '@type': 'MedicalWebPage',
    '@id': `${drugUrl}#webpage`,
    url: drugUrl,
    name: productName,
    ...(data.summary ? { description: data.summary } : {}),
    inLanguage: 'zh-CN',
    ...(dateModified ? { dateModified } : {}),
    isPartOf: { '@id': `${siteBase}/#website` },
    about: {
      '@type': 'Thing',
      name: productName,
      ...(altNames.length ? { alternateName: altNames } : {}),
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${drugUrl}#breadcrumb`,
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      ...(crumb.href ? { item: `${siteBase}${crumb.href}` } : { item: drugUrl }),
    })),
  },
];
---

<BaseLayout title={productName} description={data.summary} locale={locale} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <article class="drug">
    <header class="drug__header">
      <h1 class="drug__name">{productName}</h1>
      <p class="drug__generic">
        <span class="drug__generic-label">{t(locale, 'drug.genericName')}</span>
        <span class="drug__generic-name">{data.genericName}</span>
        {data.genericNameEn && <span class="drug__generic-en" lang="en">{data.genericNameEn}</span>}
      </p>
      <div class="drug__meta">
        {data.drugClass && <span class="chip drug__class">{data.drugClass}</span>}
        {companyRefId && (
          <a
            class="btn btn--ghost drug__company"
            href={toCompanyUrl(companyRefId)}
            aria-label={companyDisplayName ?? t(locale, 'drug.company')}
          >
            {companyName ?? t(locale, 'drug.company')}
          </a>
        )}
      </div>
      {data.summary && <p class="drug__summary">{data.summary}</p>}
    </header>

    <Disclaimer locale={locale} variant="prominent" />

    <MechanismLayers
      mechanism={data.mechanism}
      locale={locale}
      heading={mechanismHeading}
      scopeNote={t(locale, 'mechanism.productScope')}
    />

    <MechanismMedia
      media={data.media}
      locale={locale}
      heading={mediaHeading}
      subjectLabel={productName}
    />

    <section class="drug__indications" aria-label={t(locale, 'drug.indicationsByRegion')}>
      <h2>{t(locale, 'drug.indicationsByRegion')}</h2>
      {data.indications.map((group) => (
        <div class="drug__indication-group">
          <h3 class="drug__indication-region">
            <span class="drug__indication-place">
              {group.regulator ? `${group.region} · ${group.regulator}` : group.region}
            </span>
            {group.asOf && (
              <span class="drug__indication-asof">{t(locale, 'drug.asOf')} {group.asOf}</span>
            )}
          </h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
      <p class="drug__indications-note">{t(locale, 'drug.indicationsNote')}</p>
    </section>

    <section class="drug__target" aria-label={t(locale, 'drug.target')}>
      <h2>{t(locale, 'drug.target')}</h2>
      <p class="drug__target-name">
        <strong>{data.target.name}</strong>
        <span class="chip drug__target-type">{t(locale, `targetType.${data.target.type}`)}</span>
      </p>
      <p class="drug__target-role">{data.target.role}</p>
    </section>

    <Citations citations={data.citations} locale={locale} />
  </article>
</BaseLayout>
