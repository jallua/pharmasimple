---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { publishedDrugDetailPaths, relatedDrugs, slugOf, toCompanyUrl, toDrugUrl } from '../../lib/catalog';
import MechanismLayers from '../../components/MechanismLayers.astro';
import MechanismMedia from '../../components/MechanismMedia.astro';
import Citations from '../../components/Citations.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t } from '../../lib/i18n';

export async function getStaticPaths() {
  const drugs = await getCollection('drugs');
  return publishedDrugDetailPaths(drugs);
}

const locale = 'zh';
const { drug } = Astro.props;
const { data } = drug;

const companyRefValue = data.company as unknown;
const companyRefId =
  typeof companyRefValue === 'string'
    ? companyRefValue
    : ((companyRefValue as { id?: string; slug?: string })?.id ??
       (companyRefValue as { id?: string; slug?: string })?.slug ??
       '');

const companies = await getCollection('companies');
const companyName = companies.find((c) => slugOf(c) === companyRefId)?.data.name;

const allDrugs = await getCollection('drugs');
const related = relatedDrugs(allDrugs, slugOf(drug));

const crumbs = [
  { label: t(locale, 'nav.home'), href: '/' },
  { label: t(locale, 'nav.drugs'), href: '/drugs' },
  { label: data.genericName },
];

const siteBase = (Astro.site?.href ?? 'https://dongyaojun.com/').replace(/\/+$/, '');
const drugUrl = `${siteBase}/drugs/${slugOf(drug)}/`;
const jsonLd = [
  {
    '@type': 'Drug',
    name: data.genericName,
    ...(data.brandName ? { alternateName: data.brandName } : {}),
    ...(data.summary ? { description: data.summary } : {}),
    ...(data.drugClass ? { drugClass: data.drugClass } : {}),
    mechanismOfAction: data.mechanism.simple,
    url: drugUrl,
    inLanguage: 'zh-CN',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'nav.home'), item: `${siteBase}/` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'nav.drugs'), item: `${siteBase}/drugs/` },
      { '@type': 'ListItem', position: 3, name: data.genericName, item: drugUrl },
    ],
  },
];
---

<BaseLayout title={data.genericName} description={data.summary} locale={locale} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <article class="drug">
    <header class="drug__header">
      <h1 class="drug__name">{data.genericName}</h1>
      {data.brandName && <p class="drug__brand">{data.brandName}</p>}
      <div class="drug__meta">
        {data.drugClass && <span class="chip drug__class">{data.drugClass}</span>}
        {companyRefId && (
          <a class="btn btn--ghost drug__company" href={toCompanyUrl(companyRefId)}>
            {companyName ?? t(locale, 'drug.company')}
          </a>
        )}
      </div>
      {data.summary && <p class="drug__summary">{data.summary}</p>}
    </header>

    <Disclaimer locale={locale} variant="prominent" />

    <MechanismLayers mechanism={data.mechanism} locale={locale} />

    <MechanismMedia media={data.media} locale={locale} subjectLabel={data.genericName} />

    <section class="drug__indications" aria-label={t(locale, 'drug.indicationsByRegion')}>
      <h2>{t(locale, 'drug.indicationsByRegion')}</h2>
      {data.indications.map((group) => (
        <div class="drug__indication-group">
          <h3 class="drug__indication-region">
            <span class="drug__indication-place">
              {group.regulator ? `${group.region} · ${group.regulator}` : group.region}
            </span>
            {group.asOf && (
              <span class="drug__indication-asof">{t(locale, 'drug.asOf')} {group.asOf}</span>
            )}
          </h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
      <p class="drug__indications-note">{t(locale, 'drug.indicationsNote')}</p>
    </section>

    <section class="drug__target" aria-label={t(locale, 'drug.target')}>
      <h2>{t(locale, 'drug.target')}</h2>
      <p class="drug__target-name">
        <strong>{data.target.name}</strong>
        <span class="chip drug__target-type">{t(locale, `targetType.${data.target.type}`)}</span>
      </p>
      <p class="drug__target-role">{data.target.role}</p>
    </section>

    {related.length > 0 && (
      <section class="related-drugs" aria-label={t(locale, 'drug.relatedTitle')}>
        <h2>{t(locale, 'drug.relatedTitle')}</h2>
        <p class="related-drugs__lead">{t(locale, 'drug.relatedLead')}</p>
        <ul class="related-drugs__list">
          {related.map((r) => (
            <li class="related-drugs__item">
              <a class="card related-drugs__card" href={toDrugUrl(slugOf(r))}>
                <span class="related-drugs__name">{r.data.genericName}</span>
                {r.data.brandName && <span class="related-drugs__brand">{r.data.brandName}</span>}
                {r.data.drugClass && <span class="chip">{r.data.drugClass}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Citations citations={data.citations} locale={locale} />
  </article>
</BaseLayout>
