---
// Search page (UX: a persistent, dedicated search destination reachable from
// the header on every page, instead of only the homepage #search anchor).
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
import { t } from '../lib/i18n';

const locale = 'zh';
---

<BaseLayout title={t(locale, 'nav.search')} description={t(locale, 'search.pageLead')} locale={locale}>
  <h1>{t(locale, 'search.title')}</h1>
  <p class="drugs-index__lead">{t(locale, 'search.pageLead')}</p>
  <Search locale={locale} />
</BaseLayout>
