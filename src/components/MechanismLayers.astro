---
// MechanismLayers.astro — layered mechanism explainer (Task 6.1 / 需求 3).
//
// Renders all three layers — the one-line analogy, the plain-language
// ("simple") layer, and the advanced layer — directly and always-visible, each
// with its own <h3> label. There is no collapse/expand: the three layers all
// describe the same mechanism and are shown together, so nothing is hidden
// behind an interaction (需求 3). All labels come from i18n (需求 10); the
// advanced card carries a subtly distinct tint (see global.css) while staying
// as accessible as the other two layers.
import type { Mechanism } from '../lib/catalog';
import { t } from '../lib/i18n';

interface Props {
  mechanism: Mechanism;
  locale?: string;
  heading?: string;
}

const { mechanism, locale = 'zh', heading } = Astro.props;
const headingText = heading ?? t(locale, 'mechanism.heading');
---

<section class="mechanism" aria-label={headingText}>
  <h2 class="mechanism__heading">{headingText}</h2>

  <div class="mechanism__layer mechanism__layer--analogy">
    <h3 class="mechanism__label">{t(locale, 'mechanism.analogy')}</h3>
    <p class="mechanism__text">{mechanism.analogy}</p>
  </div>

  <div class="mechanism__layer mechanism__layer--simple">
    <h3 class="mechanism__label">{t(locale, 'mechanism.simple')}</h3>
    <p class="mechanism__text">{mechanism.simple}</p>
  </div>

  {/* Advanced layer shown directly, like analogy/simple (需求 3 — 三层直接展示). */}
  <div class="mechanism__layer mechanism__layer--advanced">
    <h3 class="mechanism__label">{t(locale, 'mechanism.advanced')}</h3>
    <p class="mechanism__text">{mechanism.advanced}</p>
  </div>
</section>
