---
// MechanismMedia.astro — mechanism figures/animations (需求 4, 13). Media is
// OPTIONAL; renders ONLY code-verified, ready content (a registered animation
// whose key resolves — P6 — or an image with a src). Every rendered item keeps
// its `alt`. Animation figures also get an accessible pause/resume control
// (progressive enhancement; without JS the animation just plays, still
// respecting the user's prefers-reduced-motion setting). The toggle script is
// emitted (inline) ONLY when there is renderable media, so the component still
// renders nothing at all when media is absent/in-progress.
import type { Media } from '../lib/catalog';
import { getAnimation } from './animations';
import { t } from '../lib/i18n';

interface Props {
  media?: Media[];
  locale?: string;
  heading?: string;
  subjectLabel?: string;
}

const { media = [], locale = 'zh', heading, subjectLabel } = Astro.props;
const headingText = heading ?? t(locale, 'mechanism.heading');
const pauseLabel = t(locale, 'mechanism.pauseAnimation');
const scopeNote = t(locale, 'mechanism.mediaScope');

const resolveAnimation = (item: Media) =>
  item.type === 'animation' && item.status !== 'in-progress'
    ? getAnimation(item.animationKey)
    : undefined;

const isImage = (item: Media): boolean => item.type === 'image' && !!item.src;

const hasRenderable = media.some((item) => resolveAnimation(item) || isImage(item));

const animToggleScript =
  "document.querySelectorAll('.anim-toggle').forEach(function(btn){btn.addEventListener('click',function(){var fig=btn.closest('.mechanism-media__item');if(!fig)return;var paused=fig.classList.toggle('is-paused');btn.setAttribute('aria-pressed',String(paused));btn.textContent=paused?'\u64ad\u653e\u52a8\u753b':'\u6682\u505c\u52a8\u753b';});});";
---

{
  hasRenderable && (
    <>
      <section class="mechanism-media" aria-label={headingText}>
        <h2 class="mechanism-media__heading">{headingText}</h2>
        <p class="mechanism-media__scope" role="note">{scopeNote}</p>
        {media.map((item) => {
          const AnimationComponent = resolveAnimation(item);
          if (!AnimationComponent && !isImage(item)) return null;
          return (
            <figure class="mechanism-media__item" aria-label={item.alt}>
              {AnimationComponent ? (
                <>
                  <div class="mechanism-media__anim">
                    <AnimationComponent alt={item.alt} caption={item.caption} subject={subjectLabel} />
                  </div>
                  <button type="button" class="anim-toggle" aria-pressed="false">
                    {pauseLabel}
                  </button>
                </>
              ) : (
                <img
                  class="mechanism-media__image"
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {item.caption && (
                <figcaption class="mechanism-media__caption">{item.caption}</figcaption>
              )}
            </figure>
          );
        })}
      </section>
      <script is:inline set:html={animToggleScript} />
    </>
  )
}
