---
// Statin.astro — schematic, self-contained SVG + CSS animation of how a statin
// (HMG-CoA reductase inhibitor, e.g. 阿托伐他汀 / atorvastatin) blocks the liver's
// key cholesterol-making enzyme, so the liver makes less cholesterol and pulls
// more "bad" LDL out of the blood, lowering blood lipids (需求 4, 13). SCHEMATIC
// labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps
// cycle on a shared 15s timeline (3s each). Under prefers-reduced-motion all
// motion stops and the diagram freezes on a coherent end-state.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示他汀卡住肝脏合成胆固醇的关键酶 HMG-CoA 还原酶,使肝脏减少造胆固醇、多回收血里的坏胆固醇,血脂随之下降。',
  subject,
} = Astro.props;

const steps = [
  '肝脏用 HMG-CoA 还原酶这台"机器"制造胆固醇',
  '胆固醇造得多,血里"坏胆固醇"(LDL)偏高',
  '他汀卡住这台机器',
  '肝脏少造胆固醇,转而多回收血里的 LDL',
  '血里的坏胆固醇下降',
];
---

<div class="statin">
  <svg class="statin__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="statin__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="statin__t statin__t--organ" x="36" y="196" text-anchor="start">肝细胞</text>
    <rect class="statin__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="statin__t statin__t--small" x="208" y="126" text-anchor="middle">HMG-CoA 还原酶</text>

    <g class="statin__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="statin__t statin__t--harm" x="208" y="66" text-anchor="middle">坏胆固醇(LDL)偏高</text>
    </g>

    <g class="statin__dots">
      <circle class="statin__ldl" cx="70" cy="52" r="10" />
      <circle class="statin__ldl" cx="118" cy="36" r="10" />
      <circle class="statin__ldl" cx="96" cy="82" r="10" />
      <text class="statin__t statin__t--small" x="96" y="16" text-anchor="middle">胆固醇 / LDL</text>
    </g>

    <circle class="statin__dock-dot" cx="208" cy="140" r="9" />

    <g class="statin__drug">
      <rect class="statin__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="statin__t statin__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '他汀'}</text>
    </g>

    <g class="statin__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="statin__t statin__t--shield" x="208" y="150" text-anchor="middle">停工</text>
    </g>

    <g class="statin__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="statin__t statin__t--resolved" x="279" y="50" text-anchor="middle">坏胆固醇下降</text>
    </g>
  </svg>

  <ol class="statin__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="statin__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .statin {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .statin__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .statin__cell { fill: #fff7ed; stroke: #fdba74; stroke-width: 2; }
  .statin__receptor { fill: #64748b; }
  .statin__t { fill: #1e293b; font-size: 13px; }
  .statin__t--organ { fill: #475569; font-size: 12px; }
  .statin__t--small { font-size: 11px; fill: #475569; }
  .statin__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .statin__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .statin__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .statin__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .statin__ldl { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; }
  .statin__dots { animation: statin-drift var(--dur) infinite; }
  .statin__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .statin__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: statin-inflame var(--dur) infinite; }
  .statin__dock-dot { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; opacity: 0; animation: statin-dock var(--dur) infinite; }
  .statin__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .statin__drug { opacity: 0; animation: statin-bind var(--dur) infinite; }
  .statin__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .statin__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: statin-pop var(--dur) infinite; }
  .statin__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .statin__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: statin-pop-late var(--dur) infinite; }
  .statin__steps { counter-reset: statinstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .statin__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: statin-step var(--dur) infinite; }
  .statin__step::before { counter-increment: statinstep; content: counter(statinstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: statin-badge var(--dur) infinite; }
  .statin__step:nth-child(1), .statin__step:nth-child(1)::before { animation-delay: 0s; }
  .statin__step:nth-child(2), .statin__step:nth-child(2)::before { animation-delay: 3s; }
  .statin__step:nth-child(3), .statin__step:nth-child(3)::before { animation-delay: 6s; }
  .statin__step:nth-child(4), .statin__step:nth-child(4)::before { animation-delay: 9s; }
  .statin__step:nth-child(5), .statin__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes statin-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes statin-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes statin-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes statin-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes statin-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes statin-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes statin-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes statin-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .statin *, .statin__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .statin__step, .statin__step::before { animation: none !important; transform: none !important; }
    .statin__step { opacity: 1 !important; }
    .statin__drug { opacity: 1 !important; }
    .statin__shield { opacity: 1 !important; }
    .statin__resolved { opacity: 1 !important; }
    .statin__harm { opacity: 0 !important; }
    .statin__dock-dot { opacity: 0 !important; }
  }
</style>
