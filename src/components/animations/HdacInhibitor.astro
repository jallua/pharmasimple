---
// HdacInhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// HDAC inhibitor (e.g. 西达本胺 / chidamide) blocks the HDAC enzyme that strips
// "acetyl tags" off the gene spools and silences tumor-suppressor genes; blocking
// HDAC keeps the tags on, re-opening the silenced genes and reining in the cancer
// cell (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO
// JavaScript. Five storyboard steps cycle on a shared 15s timeline (3s each).
// Under prefers-reduced-motion all motion stops and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 HDAC 抑制剂卡住 HDAC 酶,使乙酰标签保留、被沉默的抑癌基因重新开启,从而抑制癌细胞。',
  subject,
} = Astro.props;

const steps = [
  '癌细胞里,HDAC 酶不停"撕掉"基因线轴上的乙酰标签',
  '标签被撕,"抑癌基因"被关闭,癌细胞更易疯长',
  '这个药卡住 HDAC 酶',
  '乙酰标签保留下来',
  '"抑癌基因"重新开启,癌细胞被抑制',
];
---

<div class="hdac">
  <svg class="hdac__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="hdac__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="hdac__t hdac__t--organ" x="36" y="196" text-anchor="start">癌细胞(基因线轴)</text>
    <rect class="hdac__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="hdac__t hdac__t--small" x="208" y="126" text-anchor="middle">HDAC 酶</text>

    <g class="hdac__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="hdac__t hdac__t--harm" x="208" y="66" text-anchor="middle">抑癌基因被关闭</text>
    </g>

    <g class="hdac__dots">
      <circle class="hdac__tag" cx="70" cy="52" r="10" />
      <circle class="hdac__tag" cx="118" cy="36" r="10" />
      <circle class="hdac__tag" cx="96" cy="82" r="10" />
      <text class="hdac__t hdac__t--small" x="96" y="16" text-anchor="middle">乙酰标签</text>
    </g>

    <circle class="hdac__dock-dot" cx="208" cy="140" r="9" />

    <g class="hdac__drug">
      <rect class="hdac__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="hdac__t hdac__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'HDAC 抑制剂'}</text>
    </g>

    <g class="hdac__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="hdac__t hdac__t--shield" x="208" y="150" text-anchor="middle">卡住</text>
    </g>

    <g class="hdac__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="hdac__t hdac__t--resolved" x="279" y="50" text-anchor="middle">抑癌基因重新开启</text>
    </g>
  </svg>

  <ol class="hdac__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="hdac__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .hdac {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .hdac__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .hdac__cell { fill: #f5f3ff; stroke: #c4b5fd; stroke-width: 2; }
  .hdac__receptor { fill: #64748b; }
  .hdac__t { fill: #1e293b; font-size: 13px; }
  .hdac__t--organ { fill: #475569; font-size: 12px; }
  .hdac__t--small { font-size: 11px; fill: #475569; }
  .hdac__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .hdac__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .hdac__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .hdac__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .hdac__tag { fill: #2dd4bf; stroke: #0f766e; stroke-width: 1.5; }
  .hdac__dots { animation: hdac-drift var(--dur) infinite; }
  .hdac__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .hdac__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: hdac-inflame var(--dur) infinite; }
  .hdac__dock-dot { fill: #2dd4bf; stroke: #0f766e; stroke-width: 1.5; opacity: 0; animation: hdac-dock var(--dur) infinite; }
  .hdac__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .hdac__drug { opacity: 0; animation: hdac-bind var(--dur) infinite; }
  .hdac__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .hdac__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: hdac-pop var(--dur) infinite; }
  .hdac__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .hdac__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: hdac-pop-late var(--dur) infinite; }
  .hdac__steps { counter-reset: hdacstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .hdac__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: hdac-step var(--dur) infinite; }
  .hdac__step::before { counter-increment: hdacstep; content: counter(hdacstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: hdac-badge var(--dur) infinite; }
  .hdac__step:nth-child(1), .hdac__step:nth-child(1)::before { animation-delay: 0s; }
  .hdac__step:nth-child(2), .hdac__step:nth-child(2)::before { animation-delay: 3s; }
  .hdac__step:nth-child(3), .hdac__step:nth-child(3)::before { animation-delay: 6s; }
  .hdac__step:nth-child(4), .hdac__step:nth-child(4)::before { animation-delay: 9s; }
  .hdac__step:nth-child(5), .hdac__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes hdac-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes hdac-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes hdac-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes hdac-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes hdac-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes hdac-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes hdac-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes hdac-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .hdac *, .hdac__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .hdac__step, .hdac__step::before { animation: none !important; transform: none !important; }
    .hdac__step { opacity: 1 !important; }
    .hdac__drug { opacity: 1 !important; }
    .hdac__shield { opacity: 1 !important; }
    .hdac__resolved { opacity: 1 !important; }
    .hdac__harm { opacity: 0 !important; }
    .hdac__dock-dot { opacity: 0 !important; }
  }
</style>
