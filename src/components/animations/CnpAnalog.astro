---
// CnpAnalog.astro — schematic, self-contained SVG + CSS animation of how a C-type
// natriuretic peptide (CNP) analog (e.g. 伏索利肽 / vosoritide) binds the NPR-B
// receptor on growth-plate chondrocytes and, by raising cGMP, counteracts the
// overactive FGFR3 signalling that brakes bone growth in achondroplasia — so the
// growth plate resumes making bone and children grow taller (需求 4, 13).
// SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five
// storyboard steps cycle on a shared 15s timeline (3s each). Under
// prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 CNP 类似物结合软骨细胞的 NPR-B 受体,对抗过度活跃的 FGFR3、松开长骨生长的“刹车”,生长板软骨生长恢复。',
  subject,
} = Astro.props;

const steps = [
  '软骨生长板上,软骨细胞不断分裂、把长骨顶长',
  '软骨发育不全:FGFR3 过度活跃,像踩住生长的“刹车”',
  '伏索利肽(CNP 类似物)结合软骨细胞的 NPR-B 受体',
  '升高 cGMP、对抗 FGFR3 的过度信号,松开“刹车”',
  '软骨与长骨生长恢复,身高增长改善',
];
---

<div class="cnp">
  <svg class="cnp__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="cnp__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="cnp__t cnp__t--organ" x="36" y="196" text-anchor="start">软骨生长板</text>
    <rect class="cnp__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="cnp__t cnp__t--small" x="208" y="126" text-anchor="middle">NPR-B 受体</text>

    <g class="cnp__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="cnp__t cnp__t--harm" x="208" y="66" text-anchor="middle">FGFR3 过度活跃</text>
    </g>

    <g class="cnp__dots">
      <circle class="cnp__chon" cx="70" cy="52" r="10" />
      <circle class="cnp__chon" cx="118" cy="36" r="10" />
      <circle class="cnp__chon" cx="96" cy="82" r="10" />
      <text class="cnp__t cnp__t--small" x="96" y="16" text-anchor="middle">软骨细胞</text>
    </g>

    <circle class="cnp__dock-dot" cx="208" cy="140" r="9" />

    <g class="cnp__drug">
      <rect class="cnp__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="cnp__t cnp__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '伏索利肽'}</text>
    </g>

    <g class="cnp__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="cnp__t cnp__t--shield" x="208" y="150" text-anchor="middle">松刹车</text>
    </g>

    <g class="cnp__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="cnp__t cnp__t--resolved" x="275" y="50" text-anchor="middle">长骨生长改善</text>
    </g>
  </svg>

  <ol class="cnp__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="cnp__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .cnp {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .cnp__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .cnp__cell { fill: #f0f9ff; stroke: #bae6fd; stroke-width: 2; }
  .cnp__receptor { fill: #64748b; }
  .cnp__t { fill: #1e293b; font-size: 13px; }
  .cnp__t--organ { fill: #475569; font-size: 12px; }
  .cnp__t--small { font-size: 11px; fill: #475569; }
  .cnp__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .cnp__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .cnp__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .cnp__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .cnp__chon { fill: #6ee7b7; stroke: #059669; stroke-width: 1.5; }
  .cnp__dots { animation: cnp-drift var(--dur) infinite; }
  .cnp__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .cnp__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cnp-inflame var(--dur) infinite; }
  .cnp__dock-dot { fill: #6ee7b7; stroke: #059669; stroke-width: 1.5; opacity: 0; animation: cnp-dock var(--dur) infinite; }
  .cnp__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .cnp__drug { opacity: 0; animation: cnp-bind var(--dur) infinite; }
  .cnp__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .cnp__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cnp-pop var(--dur) infinite; }
  .cnp__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .cnp__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cnp-pop-late var(--dur) infinite; }
  .cnp__steps { counter-reset: cnpstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .cnp__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: cnp-step var(--dur) infinite; }
  .cnp__step::before { counter-increment: cnpstep; content: counter(cnpstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: cnp-badge var(--dur) infinite; }
  .cnp__step:nth-child(1), .cnp__step:nth-child(1)::before { animation-delay: 0s; }
  .cnp__step:nth-child(2), .cnp__step:nth-child(2)::before { animation-delay: 3s; }
  .cnp__step:nth-child(3), .cnp__step:nth-child(3)::before { animation-delay: 6s; }
  .cnp__step:nth-child(4), .cnp__step:nth-child(4)::before { animation-delay: 9s; }
  .cnp__step:nth-child(5), .cnp__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes cnp-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes cnp-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes cnp-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes cnp-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes cnp-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes cnp-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes cnp-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes cnp-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .cnp *, .cnp__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .cnp__step, .cnp__step::before { animation: none !important; transform: none !important; }
    .cnp__step { opacity: 1 !important; }
    .cnp__drug { opacity: 1 !important; }
    .cnp__shield { opacity: 1 !important; }
    .cnp__resolved { opacity: 1 !important; }
    .cnp__harm { opacity: 0 !important; }
    .cnp__dock-dot { opacity: 0 !important; }
  }
</style>