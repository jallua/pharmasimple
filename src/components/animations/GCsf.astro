---
// GCsf.astro — schematic, self-contained SVG + CSS animation of how a long-acting
// G-CSF (granulocyte colony-stimulating factor, e.g. 艾氟培格司亭 / eflapegrastim)
// binds the G-CSF receptor on bone-marrow myeloid progenitors and drives them to
// make and release more neutrophils, so the neutrophil count recovers after
// chemotherapy and infection risk drops (需求 4, 13). SCHEMATIC labelled shapes,
// inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a
// shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示长效 G-CSF 结合骨髓上的 G-CSF 受体,催促骨髓多造中性粒细胞,化疗后白细胞回升、感染风险下降。',
  subject,
} = Astro.props;

const steps = [
  '化疗会误伤骨髓这座“白细胞工厂”',
  '中性粒细胞骤减,身体容易被感染',
  '长效 G-CSF 结合骨髓的 G-CSF 受体',
  '受体被激活,催骨髓多造中性粒细胞',
  '中性粒细胞回升,感染风险下降',
];
---

<div class="gcsf">
  <svg class="gcsf__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="gcsf__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="gcsf__t gcsf__t--organ" x="36" y="196" text-anchor="start">骨髓</text>
    <rect class="gcsf__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="gcsf__t gcsf__t--small" x="208" y="126" text-anchor="middle">G-CSF 受体</text>

    <g class="gcsf__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="gcsf__t gcsf__t--harm" x="208" y="66" text-anchor="middle">中性粒细胞过少 · 易感染</text>
    </g>

    <g class="gcsf__dots">
      <circle class="gcsf__celldot" cx="70" cy="52" r="10" />
      <circle class="gcsf__celldot" cx="118" cy="36" r="10" />
      <circle class="gcsf__celldot" cx="96" cy="82" r="10" />
      <text class="gcsf__t gcsf__t--small" x="96" y="16" text-anchor="middle">中性粒细胞</text>
    </g>

    <circle class="gcsf__dock-dot" cx="208" cy="140" r="9" />

    <g class="gcsf__drug">
      <rect class="gcsf__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="gcsf__t gcsf__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '长效 G-CSF'}</text>
    </g>

    <g class="gcsf__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="gcsf__t gcsf__t--shield" x="208" y="150" text-anchor="middle">催造</text>
    </g>

    <g class="gcsf__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="gcsf__t gcsf__t--resolved" x="275" y="50" text-anchor="middle">白细胞回升 · 感染↓</text>
    </g>
  </svg>

  <ol class="gcsf__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="gcsf__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .gcsf {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .gcsf__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .gcsf__cell { fill: #fff1f2; stroke: #fda4af; stroke-width: 2; }
  .gcsf__receptor { fill: #64748b; }
  .gcsf__t { fill: #1e293b; font-size: 13px; }
  .gcsf__t--organ { fill: #475569; font-size: 12px; }
  .gcsf__t--small { font-size: 11px; fill: #475569; }
  .gcsf__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .gcsf__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .gcsf__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .gcsf__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .gcsf__celldot { fill: #93c5fd; stroke: #2563eb; stroke-width: 1.5; }
  .gcsf__dots { animation: gcsf-drift var(--dur) infinite; }
  .gcsf__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .gcsf__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gcsf-inflame var(--dur) infinite; }
  .gcsf__dock-dot { fill: #93c5fd; stroke: #2563eb; stroke-width: 1.5; opacity: 0; animation: gcsf-dock var(--dur) infinite; }
  .gcsf__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .gcsf__drug { opacity: 0; animation: gcsf-bind var(--dur) infinite; }
  .gcsf__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .gcsf__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gcsf-pop var(--dur) infinite; }
  .gcsf__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .gcsf__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gcsf-pop-late var(--dur) infinite; }
  .gcsf__steps { counter-reset: gcsfstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .gcsf__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: gcsf-step var(--dur) infinite; }
  .gcsf__step::before { counter-increment: gcsfstep; content: counter(gcsfstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: gcsf-badge var(--dur) infinite; }
  .gcsf__step:nth-child(1), .gcsf__step:nth-child(1)::before { animation-delay: 0s; }
  .gcsf__step:nth-child(2), .gcsf__step:nth-child(2)::before { animation-delay: 3s; }
  .gcsf__step:nth-child(3), .gcsf__step:nth-child(3)::before { animation-delay: 6s; }
  .gcsf__step:nth-child(4), .gcsf__step:nth-child(4)::before { animation-delay: 9s; }
  .gcsf__step:nth-child(5), .gcsf__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes gcsf-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes gcsf-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes gcsf-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes gcsf-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes gcsf-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes gcsf-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes gcsf-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes gcsf-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .gcsf *, .gcsf__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .gcsf__step, .gcsf__step::before { animation: none !important; transform: none !important; }
    .gcsf__step { opacity: 1 !important; }
    .gcsf__drug { opacity: 1 !important; }
    .gcsf__shield { opacity: 1 !important; }
    .gcsf__resolved { opacity: 1 !important; }
    .gcsf__harm { opacity: 0 !important; }
    .gcsf__dock-dot { opacity: 0 !important; }
  }
</style>