---
// Sglt2Inhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// SGLT2 inhibitor (e.g. 恩格列净 / empagliflozin) shuts the SGLT2 "reabsorption
// pump" on a kidney tubule cell, so filtered glucose is no longer pulled back
// into the blood and instead leaves in the urine, lowering blood sugar
// (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO
// JavaScript. Five storyboard steps cycle on a shared 15s timeline (3s each).
// Under prefers-reduced-motion all motion stops and the diagram freezes on a
// coherent end-state (drug capping SGLT2, pump off, blood sugar down).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 SGLT2 抑制剂关掉肾小管细胞上的 SGLT2 回收泵,使滤出的葡萄糖不再被重吸收回血液,而是随尿排出,血糖随之下降。',
  subject,
} = Astro.props;

const steps = [
  '血里的糖太多(高血糖)',
  '肾小管上的 SGLT2 泵把滤出的糖"回收"进血里',
  '这个药关掉 SGLT2 回收泵',
  '糖不再被回收',
  '多余的糖随尿排出,血糖下降',
];
---

<div class="sglt">
  <svg class="sglt__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="sglt__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="sglt__t sglt__t--organ" x="36" y="196" text-anchor="start">肾小管细胞</text>
    <rect class="sglt__pump" x="196" y="132" width="24" height="24" rx="3" />
    <text class="sglt__t sglt__t--small" x="208" y="126" text-anchor="middle">SGLT2 泵</text>

    <g class="sglt__reabsorb">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="sglt__t sglt__t--reabsorb" x="208" y="66" text-anchor="middle">把糖回收进血里</text>
    </g>

    <g class="sglt__dots">
      <circle class="sglt__glu" cx="70" cy="52" r="10" />
      <circle class="sglt__glu" cx="118" cy="36" r="10" />
      <circle class="sglt__glu" cx="96" cy="82" r="10" />
      <text class="sglt__t sglt__t--small" x="96" y="16" text-anchor="middle">滤出的葡萄糖</text>
    </g>

    <circle class="sglt__dock-dot" cx="208" cy="140" r="9" />

    <g class="sglt__drug">
      <rect class="sglt__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="sglt__t sglt__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'SGLT2 抑制剂'}</text>
    </g>

    <g class="sglt__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="sglt__t sglt__t--shield" x="208" y="150" text-anchor="middle">泵关闭</text>
    </g>

    <g class="sglt__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="sglt__t sglt__t--resolved" x="283" y="50" text-anchor="middle">随尿排出 · 血糖↓</text>
    </g>
  </svg>

  <ol class="sglt__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="sglt__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .sglt {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .sglt__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .sglt__cell { fill: #eff6ff; stroke: #93c5fd; stroke-width: 2; }
  .sglt__pump { fill: #64748b; }
  .sglt__t { fill: #1e293b; font-size: 13px; }
  .sglt__t--organ { fill: #475569; font-size: 12px; }
  .sglt__t--small { font-size: 11px; fill: #475569; }
  .sglt__t--reabsorb { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .sglt__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .sglt__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .sglt__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .sglt__glu { fill: #fbbf24; stroke: #d97706; stroke-width: 1.5; }
  .sglt__dots { animation: sglt-drift var(--dur) infinite; }
  .sglt__reabsorb polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .sglt__reabsorb { opacity: 0; transform-box: fill-box; transform-origin: center; animation: sglt-inflame var(--dur) infinite; }
  .sglt__dock-dot { fill: #fbbf24; stroke: #d97706; stroke-width: 1.5; opacity: 0; animation: sglt-dock var(--dur) infinite; }
  .sglt__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .sglt__drug { opacity: 0; animation: sglt-bind var(--dur) infinite; }
  .sglt__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .sglt__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: sglt-pop var(--dur) infinite; }
  .sglt__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .sglt__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: sglt-pop-late var(--dur) infinite; }
  .sglt__steps { counter-reset: sgltstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .sglt__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: sglt-step var(--dur) infinite; }
  .sglt__step::before { counter-increment: sgltstep; content: counter(sgltstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: sglt-badge var(--dur) infinite; }
  .sglt__step:nth-child(1), .sglt__step:nth-child(1)::before { animation-delay: 0s; }
  .sglt__step:nth-child(2), .sglt__step:nth-child(2)::before { animation-delay: 3s; }
  .sglt__step:nth-child(3), .sglt__step:nth-child(3)::before { animation-delay: 6s; }
  .sglt__step:nth-child(4), .sglt__step:nth-child(4)::before { animation-delay: 9s; }
  .sglt__step:nth-child(5), .sglt__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes sglt-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes sglt-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes sglt-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes sglt-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes sglt-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes sglt-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes sglt-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes sglt-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .sglt *, .sglt__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .sglt__step, .sglt__step::before { animation: none !important; transform: none !important; }
    .sglt__step { opacity: 1 !important; }
    .sglt__drug { opacity: 1 !important; }
    .sglt__shield { opacity: 1 !important; }
    .sglt__resolved { opacity: 1 !important; }
    .sglt__reabsorb { opacity: 0 !important; }
    .sglt__dock-dot { opacity: 0 !important; }
  }
</style>
