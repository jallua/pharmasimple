---
// Insulin.astro — schematic, self-contained SVG + CSS animation of how injected
// insulin (e.g. 甘精胰岛素 / insulin glargine) binds the insulin receptor on
// muscle / fat cells, opens the glucose "doorway", so blood glucose moves into
// the cell to be used and blood sugar falls (需求 4, 13). SCHEMATIC labelled
// shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on
// a shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops
// and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示注射的胰岛素结合细胞上的胰岛素受体,打开进糖通道,血里的葡萄糖进入细胞、血糖下降。',
  subject,
} = Astro.props;

const steps = [
  '饭后血糖升高,葡萄糖在血里堆积',
  '胰岛素不足或不好使,糖进不去细胞',
  '注射的胰岛素结合细胞的胰岛素受体',
  '细胞打开"进糖通道",把糖搬进去',
  '血里的葡萄糖被利用,血糖下降',
];
---

<div class="ins">
  <svg class="ins__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="ins__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="ins__t ins__t--organ" x="36" y="196" text-anchor="start">肌肉 / 脂肪细胞</text>
    <rect class="ins__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="ins__t ins__t--small" x="208" y="126" text-anchor="middle">胰岛素受体</text>

    <g class="ins__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="ins__t ins__t--inflam" x="208" y="66" text-anchor="middle">血糖过高</text>
    </g>

    <g class="ins__dots">
      <circle class="ins__lig" cx="70" cy="52" r="10" />
      <circle class="ins__lig" cx="118" cy="36" r="10" />
      <circle class="ins__lig" cx="96" cy="82" r="10" />
      <text class="ins__t ins__t--small" x="96" y="16" text-anchor="middle">葡萄糖(血糖)</text>
    </g>

    <circle class="ins__dock-dot" cx="208" cy="140" r="9" />

    <g class="ins__drug">
      <rect class="ins__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="ins__t ins__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '胰岛素'}</text>
    </g>

    <g class="ins__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="ins__t ins__t--shield" x="208" y="150" text-anchor="middle">打开进糖通道</text>
    </g>

    <g class="ins__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="ins__t ins__t--resolved" x="275" y="50" text-anchor="middle">葡萄糖进细胞 · 血糖下降</text>
    </g>
  </svg>

  <ol class="ins__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="ins__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .ins {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .ins__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .ins__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .ins__receptor { fill: #64748b; }
  .ins__t { fill: #1e293b; font-size: 13px; }
  .ins__t--organ { fill: #475569; font-size: 12px; }
  .ins__t--small { font-size: 11px; fill: #475569; }
  .ins__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .ins__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .ins__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .ins__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .ins__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .ins__dots { animation: ins-drift var(--dur) infinite; }
  .ins__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .ins__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ins-inflame var(--dur) infinite; }
  .ins__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: ins-dock var(--dur) infinite; }
  .ins__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .ins__drug { opacity: 0; animation: ins-bind var(--dur) infinite; }
  .ins__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .ins__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ins-pop var(--dur) infinite; }
  .ins__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .ins__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ins-pop-late var(--dur) infinite; }
  .ins__steps { counter-reset: insstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .ins__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: ins-step var(--dur) infinite; }
  .ins__step::before { counter-increment: insstep; content: counter(insstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: ins-badge var(--dur) infinite; }
  .ins__step:nth-child(1), .ins__step:nth-child(1)::before { animation-delay: 0s; }
  .ins__step:nth-child(2), .ins__step:nth-child(2)::before { animation-delay: 3s; }
  .ins__step:nth-child(3), .ins__step:nth-child(3)::before { animation-delay: 6s; }
  .ins__step:nth-child(4), .ins__step:nth-child(4)::before { animation-delay: 9s; }
  .ins__step:nth-child(5), .ins__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes ins-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes ins-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes ins-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes ins-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes ins-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes ins-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes ins-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes ins-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .ins *, .ins__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .ins__step, .ins__step::before { animation: none !important; transform: none !important; }
    .ins__step { opacity: 1 !important; }
    .ins__drug { opacity: 1 !important; }
    .ins__shield { opacity: 1 !important; }
    .ins__resolved { opacity: 1 !important; }
    .ins__inflam { opacity: 0 !important; }
    .ins__dock-dot { opacity: 0 !important; }
  }
</style>
