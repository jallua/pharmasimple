---
// IgaBudesonide.astro — schematic, self-contained SVG + CSS animation of how a
// gut-targeted-release corticosteroid (布地奈德 / budesonide, e.g. 耐赋康 /
// Nefecon) calms the overactive gut immune cells that make the pathogenic
// antibody (Gd-IgA1) driving IgA nephropathy, so fewer bad antibodies are made
// and the kidney is protected (需求 4, 13). SCHEMATIC labelled shapes, inline
// SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes on a coherent end-state (drug calming the cell, fewer
// antibodies, kidney damage reduced).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示靶向释放的布地奈德在肠道就地安抚免疫细胞,减少致病抗体 Gd-IgA1 的产生,从而减轻肾脏沉积与损伤。',
  subject,
} = Astro.props;

const steps = [
  'IgA 肾病:肠道免疫细胞过度活跃,产生"有缺陷的抗体"',
  '这些抗体流到肾脏、沉积下来,引起损伤',
  '这个药在肠道就地安抚免疫细胞',
  '"有缺陷的抗体"产生减少',
  '肾脏沉积与损伤减轻',
];
---

<div class="iga">
  <svg class="iga__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="iga__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="iga__t iga__t--organ" x="36" y="196" text-anchor="start">肠道免疫细胞</text>
    <rect class="iga__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="iga__t iga__t--small" x="208" y="126" text-anchor="middle">激素受体</text>

    <g class="iga__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="iga__t iga__t--harm" x="208" y="66" text-anchor="middle">肾脏沉积 · 损伤</text>
    </g>

    <g class="iga__dots">
      <circle class="iga__ab" cx="70" cy="52" r="10" />
      <circle class="iga__ab" cx="118" cy="36" r="10" />
      <circle class="iga__ab" cx="96" cy="82" r="10" />
      <text class="iga__t iga__t--small" x="96" y="16" text-anchor="middle">致病抗体 Gd-IgA1</text>
    </g>

    <circle class="iga__dock-dot" cx="208" cy="140" r="9" />

    <g class="iga__drug">
      <rect class="iga__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="iga__t iga__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '布地奈德'}</text>
    </g>

    <g class="iga__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="iga__t iga__t--shield" x="208" y="150" text-anchor="middle">安抚</text>
    </g>

    <g class="iga__resolved">
      <rect x="228" y="30" width="112" height="30" rx="15" />
      <text class="iga__t iga__t--resolved" x="284" y="50" text-anchor="middle">肾损伤减轻</text>
    </g>
  </svg>

  <ol class="iga__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="iga__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .iga {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .iga__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .iga__cell { fill: #ecfdf5; stroke: #6ee7b7; stroke-width: 2; }
  .iga__receptor { fill: #64748b; }
  .iga__t { fill: #1e293b; font-size: 13px; }
  .iga__t--organ { fill: #475569; font-size: 12px; }
  .iga__t--small { font-size: 11px; fill: #475569; }
  .iga__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .iga__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .iga__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .iga__t--resolved { fill: #15803d; font-size: 13px; font-weight: 700; }
  .iga__ab { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .iga__dots { animation: iga-drift var(--dur) infinite; }
  .iga__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .iga__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: iga-inflame var(--dur) infinite; }
  .iga__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: iga-dock var(--dur) infinite; }
  .iga__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .iga__drug { opacity: 0; animation: iga-bind var(--dur) infinite; }
  .iga__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .iga__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: iga-pop var(--dur) infinite; }
  .iga__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .iga__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: iga-pop-late var(--dur) infinite; }
  .iga__steps { counter-reset: igastep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .iga__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: iga-step var(--dur) infinite; }
  .iga__step::before { counter-increment: igastep; content: counter(igastep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: iga-badge var(--dur) infinite; }
  .iga__step:nth-child(1), .iga__step:nth-child(1)::before { animation-delay: 0s; }
  .iga__step:nth-child(2), .iga__step:nth-child(2)::before { animation-delay: 3s; }
  .iga__step:nth-child(3), .iga__step:nth-child(3)::before { animation-delay: 6s; }
  .iga__step:nth-child(4), .iga__step:nth-child(4)::before { animation-delay: 9s; }
  .iga__step:nth-child(5), .iga__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes iga-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes iga-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes iga-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes iga-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes iga-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes iga-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes iga-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes iga-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .iga *, .iga__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .iga__step, .iga__step::before { animation: none !important; transform: none !important; }
    .iga__step { opacity: 1 !important; }
    .iga__drug { opacity: 1 !important; }
    .iga__shield { opacity: 1 !important; }
    .iga__resolved { opacity: 1 !important; }
    .iga__harm { opacity: 0 !important; }
    .iga__dock-dot { opacity: 0 !important; }
  }
</style>
