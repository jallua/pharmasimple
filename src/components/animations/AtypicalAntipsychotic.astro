---
// AtypicalAntipsychotic.astro — schematic, self-contained SVG + CSS animation of
// how an atypical (second-generation) antipsychotic (e.g. 鲁拉西酮 / lurasidone)
// blocks overactive dopamine D2 receptors (and serotonin 5-HT2A receptors), so
// the excessive dopamine signal is turned down and positive symptoms such as
// hallucinations and delusions ease (需求 4, 13). SCHEMATIC labelled shapes,
// inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a
// shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示非典型抗精神病药挡住过度活跃的多巴胺 D2 受体并阻断 5-HT2A,把过强的多巴胺信号调低,幻觉妄想等症状随之减轻。',
  subject,
} = Astro.props;

const steps = [
  '脑内某些通路多巴胺信号过强',
  '多巴胺接上 D2 受体,信号被过度放大',
  '抗精神病药挡住 D2 受体(并阻断 5-HT2A)',
  '过强的多巴胺信号被调低',
  '幻觉妄想等症状随之减轻',
];
---

<div class="aap">
  <svg class="aap__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="aap__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="aap__t aap__t--organ" x="36" y="196" text-anchor="start">脑内神经元</text>
    <rect class="aap__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="aap__t aap__t--small" x="208" y="126" text-anchor="middle">多巴胺 D2 受体</text>

    <g class="aap__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="aap__t aap__t--harm" x="208" y="66" text-anchor="middle">幻觉妄想 · 阳性症状</text>
    </g>

    <g class="aap__dots">
      <circle class="aap__dop" cx="70" cy="52" r="10" />
      <circle class="aap__dop" cx="118" cy="36" r="10" />
      <circle class="aap__dop" cx="96" cy="82" r="10" />
      <text class="aap__t aap__t--small" x="96" y="16" text-anchor="middle">多巴胺信号</text>
    </g>

    <circle class="aap__dock-dot" cx="208" cy="140" r="9" />

    <g class="aap__drug">
      <rect class="aap__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="aap__t aap__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗精神病药'}</text>
    </g>

    <g class="aap__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="aap__t aap__t--shield" x="208" y="150" text-anchor="middle">挡住</text>
    </g>

    <g class="aap__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="aap__t aap__t--resolved" x="279" y="50" text-anchor="middle">症状减轻</text>
    </g>
  </svg>

  <ol class="aap__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="aap__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .aap {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .aap__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .aap__cell { fill: #eef2ff; stroke: #a5b4fc; stroke-width: 2; }
  .aap__receptor { fill: #64748b; }
  .aap__t { fill: #1e293b; font-size: 13px; }
  .aap__t--organ { fill: #475569; font-size: 12px; }
  .aap__t--small { font-size: 11px; fill: #475569; }
  .aap__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .aap__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .aap__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .aap__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .aap__dop { fill: #c084fc; stroke: #7e22ce; stroke-width: 1.5; }
  .aap__dots { animation: aap-drift var(--dur) infinite; }
  .aap__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .aap__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: aap-inflame var(--dur) infinite; }
  .aap__dock-dot { fill: #c084fc; stroke: #7e22ce; stroke-width: 1.5; opacity: 0; animation: aap-dock var(--dur) infinite; }
  .aap__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .aap__drug { opacity: 0; animation: aap-bind var(--dur) infinite; }
  .aap__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .aap__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: aap-pop var(--dur) infinite; }
  .aap__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .aap__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: aap-pop-late var(--dur) infinite; }
  .aap__steps { counter-reset: aapstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .aap__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: aap-step var(--dur) infinite; }
  .aap__step::before { counter-increment: aapstep; content: counter(aapstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: aap-badge var(--dur) infinite; }
  .aap__step:nth-child(1), .aap__step:nth-child(1)::before { animation-delay: 0s; }
  .aap__step:nth-child(2), .aap__step:nth-child(2)::before { animation-delay: 3s; }
  .aap__step:nth-child(3), .aap__step:nth-child(3)::before { animation-delay: 6s; }
  .aap__step:nth-child(4), .aap__step:nth-child(4)::before { animation-delay: 9s; }
  .aap__step:nth-child(5), .aap__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes aap-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes aap-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes aap-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes aap-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes aap-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes aap-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes aap-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes aap-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .aap *, .aap__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .aap__step, .aap__step::before { animation: none !important; transform: none !important; }
    .aap__step { opacity: 1 !important; }
    .aap__drug { opacity: 1 !important; }
    .aap__shield { opacity: 1 !important; }
    .aap__resolved { opacity: 1 !important; }
    .aap__harm { opacity: 0 !important; }
    .aap__dock-dot { opacity: 0 !important; }
  }
</style>