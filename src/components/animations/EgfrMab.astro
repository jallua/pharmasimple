---
// EgfrMab.astro — schematic SVG + CSS animation of how an anti-EGFR monoclonal
// antibody (e.g. 西妥昔单抗 / cetuximab) binds the EGFR EXTRACELLULAR domain from
// outside the cell, blocks the growth factor (EGF) from binding, and recruits
// immune cells (ADCC) — distinct from a small-molecule TKI that acts on the
// intracellular kinase (需求 4, 13). SCHEMATIC labelled shapes, inline SVG +
// scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s timeline
// (3s each). Under prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 EGFR 抗体从细胞外套住 EGFR 胞外域、挡住生长因子并招募免疫细胞(ADCC),肿瘤快生长信号被切断。',
  subject,
} = Astro.props;

const steps = [
  '肿瘤细胞表面布满 EGFR“生长信号接收器”',
  '生长因子(EGF)接上 EGFR,催癌细胞不停分裂',
  '西妥昔单抗(抗体)从细胞外套住 EGFR 胞外域',
  '挡住 EGF 配体,还招募免疫细胞来攻击(ADCC)',
  '“快生长”信号被切断,肿瘤增殖受抑',
];
---

<div class="egm">
  <svg class="egm__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="egm__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="egm__t egm__t--organ" x="36" y="196" text-anchor="start">肿瘤细胞</text>
    <rect class="egm__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="egm__t egm__t--small" x="208" y="126" text-anchor="middle">EGFR(胞外域)</text>

    <g class="egm__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="egm__t egm__t--harm" x="208" y="66" text-anchor="middle">催癌细胞不停分裂</text>
    </g>

    <g class="egm__dots">
      <circle class="egm__lig" cx="70" cy="52" r="10" />
      <circle class="egm__lig" cx="118" cy="36" r="10" />
      <circle class="egm__lig" cx="96" cy="82" r="10" />
      <text class="egm__t egm__t--small" x="96" y="16" text-anchor="middle">生长因子(EGF)</text>
    </g>

    <circle class="egm__dock-dot" cx="208" cy="140" r="9" />

    <g class="egm__drug">
      <path class="egm__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <text class="egm__t egm__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 EGFR 抗体'}</text>
    </g>

    <g class="egm__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="egm__t egm__t--shield" x="208" y="150" text-anchor="middle">挡住配体</text>
    </g>

    <g class="egm__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="egm__t egm__t--resolved" x="283" y="50" text-anchor="middle">增殖受抑</text>
    </g>
  </svg>

  <ol class="egm__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="egm__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .egm {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .egm__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .egm__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .egm__receptor { fill: #64748b; }
  .egm__t { fill: #1e293b; font-size: 13px; }
  .egm__t--organ { fill: #475569; font-size: 12px; }
  .egm__t--small { font-size: 11px; fill: #475569; }
  .egm__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .egm__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .egm__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .egm__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .egm__lig { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; }
  .egm__dots { animation: egm-drift var(--dur) infinite; }
  .egm__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .egm__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: egm-inflame var(--dur) infinite; }
  .egm__dock-dot { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; opacity: 0; animation: egm-dock var(--dur) infinite; }
  .egm__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .egm__drug { opacity: 0; animation: egm-bind var(--dur) infinite; }
  .egm__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .egm__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: egm-pop var(--dur) infinite; }
  .egm__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .egm__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: egm-pop-late var(--dur) infinite; }
  .egm__steps { counter-reset: egmstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .egm__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: egm-step var(--dur) infinite; }
  .egm__step::before { counter-increment: egmstep; content: counter(egmstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: egm-badge var(--dur) infinite; }
  .egm__step:nth-child(1), .egm__step:nth-child(1)::before { animation-delay: 0s; }
  .egm__step:nth-child(2), .egm__step:nth-child(2)::before { animation-delay: 3s; }
  .egm__step:nth-child(3), .egm__step:nth-child(3)::before { animation-delay: 6s; }
  .egm__step:nth-child(4), .egm__step:nth-child(4)::before { animation-delay: 9s; }
  .egm__step:nth-child(5), .egm__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes egm-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes egm-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes egm-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes egm-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes egm-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes egm-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes egm-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes egm-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .egm *, .egm__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .egm__step, .egm__step::before { animation: none !important; transform: none !important; }
    .egm__step { opacity: 1 !important; }
    .egm__drug { opacity: 1 !important; }
    .egm__shield { opacity: 1 !important; }
    .egm__resolved { opacity: 1 !important; }
    .egm__harm { opacity: 0 !important; }
    .egm__dock-dot { opacity: 0 !important; }
  }
</style>