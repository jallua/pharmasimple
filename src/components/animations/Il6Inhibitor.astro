---
// Il6Inhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// anti-IL-6-receptor antibody (e.g. 托珠单抗 / tocilizumab) plugs the IL-6
// receptor so the pro-inflammatory cytokine IL-6 can no longer signal, and the
// inflammation subsides (需求 4, 13). SCHEMATIC labelled shapes, inline SVG +
// scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes on a coherent end-state (antibody capping IL-6R, IL-6 blocked,
// inflammation reduced).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 IL-6 受体抗体堵住细胞的 IL-6 受体,使 IL-6 无法传递炎症信号,炎症随之减轻。',
  subject,
} = Astro.props;

const steps = [
  'IL-6 信号过多,引发炎症',
  'IL-6 接上细胞的 IL-6 受体,点燃炎症(如关节肿痛)',
  '这个抗体堵住 IL-6 受体',
  'IL-6 接不上了',
  '炎症减轻',
];
---

<div class="il6">
  <svg class="il6__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="il6__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="il6__t il6__t--organ" x="36" y="196" text-anchor="start">炎症 / 免疫细胞</text>
    <rect class="il6__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="il6__t il6__t--small" x="208" y="126" text-anchor="middle">IL-6 受体</text>

    <g class="il6__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="il6__t il6__t--inflam" x="208" y="66" text-anchor="middle">炎症 · 关节肿痛</text>
    </g>

    <g class="il6__dots">
      <circle class="il6__lig" cx="70" cy="52" r="10" />
      <circle class="il6__lig" cx="118" cy="36" r="10" />
      <circle class="il6__lig" cx="96" cy="82" r="10" />
      <text class="il6__t il6__t--small" x="96" y="16" text-anchor="middle">IL-6 信号</text>
    </g>

    <circle class="il6__dock-dot" cx="208" cy="140" r="9" />

    <g class="il6__drug">
      <path class="il6__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <text class="il6__t il6__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 IL-6 受体抗体'}</text>
    </g>

    <g class="il6__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="il6__t il6__t--shield" x="208" y="150" text-anchor="middle">堵住</text>
    </g>

    <g class="il6__resolved">
      <rect x="228" y="30" width="112" height="30" rx="15" />
      <text class="il6__t il6__t--resolved" x="284" y="50" text-anchor="middle">炎症减轻</text>
    </g>
  </svg>

  <ol class="il6__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="il6__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .il6 {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .il6__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .il6__cell { fill: #fff7ed; stroke: #fdba74; stroke-width: 2; }
  .il6__receptor { fill: #64748b; }
  .il6__t { fill: #1e293b; font-size: 13px; }
  .il6__t--organ { fill: #475569; font-size: 12px; }
  .il6__t--small { font-size: 11px; fill: #475569; }
  .il6__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .il6__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .il6__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .il6__t--resolved { fill: #15803d; font-size: 13px; font-weight: 700; }
  .il6__lig { fill: #fb923c; stroke: #ea580c; stroke-width: 1.5; }
  .il6__dots { animation: il6-drift var(--dur) infinite; }
  .il6__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .il6__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: il6-inflame var(--dur) infinite; }
  .il6__dock-dot { fill: #fb923c; stroke: #ea580c; stroke-width: 1.5; opacity: 0; animation: il6-dock var(--dur) infinite; }
  .il6__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .il6__drug { opacity: 0; animation: il6-bind var(--dur) infinite; }
  .il6__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .il6__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: il6-pop var(--dur) infinite; }
  .il6__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .il6__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: il6-pop-late var(--dur) infinite; }
  .il6__steps { counter-reset: il6step; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .il6__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: il6-step var(--dur) infinite; }
  .il6__step::before { counter-increment: il6step; content: counter(il6step); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: il6-badge var(--dur) infinite; }
  .il6__step:nth-child(1), .il6__step:nth-child(1)::before { animation-delay: 0s; }
  .il6__step:nth-child(2), .il6__step:nth-child(2)::before { animation-delay: 3s; }
  .il6__step:nth-child(3), .il6__step:nth-child(3)::before { animation-delay: 6s; }
  .il6__step:nth-child(4), .il6__step:nth-child(4)::before { animation-delay: 9s; }
  .il6__step:nth-child(5), .il6__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes il6-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes il6-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes il6-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes il6-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes il6-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes il6-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes il6-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes il6-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .il6 *, .il6__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .il6__step, .il6__step::before { animation: none !important; transform: none !important; }
    .il6__step { opacity: 1 !important; }
    .il6__drug { opacity: 1 !important; }
    .il6__shield { opacity: 1 !important; }
    .il6__resolved { opacity: 1 !important; }
    .il6__inflam { opacity: 0 !important; }
    .il6__dock-dot { opacity: 0 !important; }
  }
</style>
