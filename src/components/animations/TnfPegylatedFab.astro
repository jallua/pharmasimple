---
// TnfPegylatedFab.astro — schematic SVG + CSS animation of how a PEGylated anti-TNF
// Fab' fragment (e.g. 培塞利珠单抗 / certolizumab pegol) neutralises TNF-α with only
// the antigen-binding "hand" (Fab) wrapped in a PEG coil and NO Fc stem — so it does
// not trigger complement/ADCC and is not carried across the placenta (需求 4, 13).
// SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard
// steps cycle on a shared 15s timeline (3s each). Under prefers-reduced-motion all
// motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示培塞利珠单抗(去掉 Fc、外裹 PEG 的抗体 Fab 片段)抓住并中和 TNF;因无 Fc,不经胎盘转运,炎症减轻。',
  subject,
} = Astro.props;

const steps = [
  'TNF 炎症信号过多,持续点燃炎症',
  '培塞利珠单抗是“半截抗体”(Fab 片段)',
  '只保留抓 TNF 的“手”,没有抗体的 Fc 尾巴',
  '抓住并中和 TNF;因无 Fc,不经胎盘转运',
  '炎症减轻,孕期也相对可用',
];
---

<div class="tpf">
  <svg class="tpf__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="tpf__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="tpf__t tpf__t--organ" x="36" y="196" text-anchor="start">免疫细胞</text>
    <rect class="tpf__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="tpf__t tpf__t--small" x="208" y="126" text-anchor="middle">TNF 受体</text>

    <g class="tpf__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="tpf__t tpf__t--harm" x="208" y="66" text-anchor="middle">炎症 · 红肿损伤</text>
    </g>

    <g class="tpf__dots">
      <circle class="tpf__lig" cx="70" cy="52" r="10" />
      <circle class="tpf__lig" cx="118" cy="36" r="10" />
      <circle class="tpf__lig" cx="96" cy="82" r="10" />
      <text class="tpf__t tpf__t--small" x="96" y="16" text-anchor="middle">TNF</text>
    </g>

    <circle class="tpf__dock-dot" cx="208" cy="140" r="9" />

    <g class="tpf__drug">
      <circle class="tpf__peg" cx="208" cy="176" r="17" />
      <path class="tpf__fab" d="M196 150 L208 168 L220 150" />
      <text class="tpf__t tpf__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'PEG 化 Fab(无 Fc)'}</text>
    </g>

    <g class="tpf__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="tpf__t tpf__t--shield" x="208" y="150" text-anchor="middle">抓住中和</text>
    </g>

    <g class="tpf__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="tpf__t tpf__t--resolved" x="275" y="50" text-anchor="middle">炎症减轻 · 不过胎盘</text>
    </g>
  </svg>

  <ol class="tpf__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="tpf__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .tpf {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .tpf__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .tpf__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .tpf__receptor { fill: #64748b; }
  .tpf__t { fill: #1e293b; font-size: 13px; }
  .tpf__t--organ { fill: #475569; font-size: 12px; }
  .tpf__t--small { font-size: 11px; fill: #475569; }
  .tpf__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .tpf__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .tpf__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .tpf__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .tpf__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .tpf__dots { animation: tpf-drift var(--dur) infinite; }
  .tpf__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .tpf__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: tpf-inflame var(--dur) infinite; }
  .tpf__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: tpf-dock var(--dur) infinite; }
  .tpf__peg { fill: none; stroke: #a855f7; stroke-width: 2; stroke-dasharray: 3 3; }
  .tpf__fab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .tpf__drug { opacity: 0; animation: tpf-bind var(--dur) infinite; }
  .tpf__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .tpf__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: tpf-pop var(--dur) infinite; }
  .tpf__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .tpf__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: tpf-pop-late var(--dur) infinite; }
  .tpf__steps { counter-reset: tpfstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .tpf__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: tpf-step var(--dur) infinite; }
  .tpf__step::before { counter-increment: tpfstep; content: counter(tpfstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: tpf-badge var(--dur) infinite; }
  .tpf__step:nth-child(1), .tpf__step:nth-child(1)::before { animation-delay: 0s; }
  .tpf__step:nth-child(2), .tpf__step:nth-child(2)::before { animation-delay: 3s; }
  .tpf__step:nth-child(3), .tpf__step:nth-child(3)::before { animation-delay: 6s; }
  .tpf__step:nth-child(4), .tpf__step:nth-child(4)::before { animation-delay: 9s; }
  .tpf__step:nth-child(5), .tpf__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes tpf-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes tpf-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes tpf-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes tpf-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes tpf-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes tpf-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes tpf-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes tpf-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .tpf *, .tpf__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .tpf__step, .tpf__step::before { animation: none !important; transform: none !important; }
    .tpf__step { opacity: 1 !important; }
    .tpf__drug { opacity: 1 !important; }
    .tpf__shield { opacity: 1 !important; }
    .tpf__resolved { opacity: 1 !important; }
    .tpf__harm { opacity: 0 !important; }
    .tpf__dock-dot { opacity: 0 !important; }
  }
</style>
