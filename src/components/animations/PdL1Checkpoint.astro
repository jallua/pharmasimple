---
// PdL1Checkpoint.astro — schematic, self-contained SVG + CSS animation of how an
// anti-PD-L1 antibody (e.g. 舒格利单抗 / sugemalimab) caps the PD-L1 "false-friend"
// signal ON THE TUMOR cell, so it can no longer press the T cell's PD-1 brake,
// and the immune cell resumes attacking the cancer (需求 4, 13). This is the
// tumor-side counterpart to the PD-1 animation. SCHEMATIC labelled shapes, inline
// SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes on a coherent end-state (antibody capping PD-L1, T cell freed).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 PD-L1 抗体盖住癌细胞表面的 PD-L1,使其无法踩住 T 细胞的刹车,让免疫细胞恢复攻击癌细胞。',
  subject,
} = Astro.props;

const steps = [
  '癌细胞打出"假朋友"信号 PD-L1',
  'PD-L1 踩住免疫卫兵(T 细胞)的刹车,让它停手',
  '这个抗体盖住癌细胞的 PD-L1',
  '卫兵的刹车不再被踩住',
  'T 细胞恢复,继续攻击癌细胞',
];
---

<div class="pdl1">
  <svg class="pdl1__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="pdl1__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="pdl1__t pdl1__t--organ" x="36" y="196" text-anchor="start">癌细胞(肿瘤)</text>
    <rect class="pdl1__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="pdl1__t pdl1__t--small" x="208" y="126" text-anchor="middle">PD-L1(癌细胞)</text>

    <g class="pdl1__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="pdl1__t pdl1__t--harm" x="208" y="66" text-anchor="middle">免疫卫兵被骗 · 停手</text>
    </g>

    <g class="pdl1__dots">
      <circle class="pdl1__sig" cx="70" cy="52" r="10" />
      <circle class="pdl1__sig" cx="118" cy="36" r="10" />
      <circle class="pdl1__sig" cx="96" cy="82" r="10" />
      <text class="pdl1__t pdl1__t--small" x="96" y="16" text-anchor="middle">免疫抑制信号</text>
    </g>

    <circle class="pdl1__dock-dot" cx="208" cy="140" r="9" />

    <g class="pdl1__drug">
      <path class="pdl1__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <text class="pdl1__t pdl1__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 PD-L1 抗体'}</text>
    </g>

    <g class="pdl1__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="pdl1__t pdl1__t--shield" x="208" y="150" text-anchor="middle">盖住</text>
    </g>

    <g class="pdl1__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="pdl1__t pdl1__t--resolved" x="279" y="50" text-anchor="middle">T 细胞恢复攻击</text>
    </g>
  </svg>

  <ol class="pdl1__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="pdl1__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .pdl1 {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .pdl1__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .pdl1__cell { fill: #fdf2f8; stroke: #f9a8d4; stroke-width: 2; }
  .pdl1__receptor { fill: #64748b; }
  .pdl1__t { fill: #1e293b; font-size: 13px; }
  .pdl1__t--organ { fill: #475569; font-size: 12px; }
  .pdl1__t--small { font-size: 11px; fill: #475569; }
  .pdl1__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .pdl1__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .pdl1__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .pdl1__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .pdl1__sig { fill: #f472b6; stroke: #be185d; stroke-width: 1.5; }
  .pdl1__dots { animation: pdl1-drift var(--dur) infinite; }
  .pdl1__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .pdl1__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pdl1-inflame var(--dur) infinite; }
  .pdl1__dock-dot { fill: #f472b6; stroke: #be185d; stroke-width: 1.5; opacity: 0; animation: pdl1-dock var(--dur) infinite; }
  .pdl1__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .pdl1__drug { opacity: 0; animation: pdl1-bind var(--dur) infinite; }
  .pdl1__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .pdl1__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pdl1-pop var(--dur) infinite; }
  .pdl1__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .pdl1__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pdl1-pop-late var(--dur) infinite; }
  .pdl1__steps { counter-reset: pdl1step; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .pdl1__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: pdl1-step var(--dur) infinite; }
  .pdl1__step::before { counter-increment: pdl1step; content: counter(pdl1step); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: pdl1-badge var(--dur) infinite; }
  .pdl1__step:nth-child(1), .pdl1__step:nth-child(1)::before { animation-delay: 0s; }
  .pdl1__step:nth-child(2), .pdl1__step:nth-child(2)::before { animation-delay: 3s; }
  .pdl1__step:nth-child(3), .pdl1__step:nth-child(3)::before { animation-delay: 6s; }
  .pdl1__step:nth-child(4), .pdl1__step:nth-child(4)::before { animation-delay: 9s; }
  .pdl1__step:nth-child(5), .pdl1__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes pdl1-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes pdl1-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes pdl1-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes pdl1-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes pdl1-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes pdl1-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes pdl1-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes pdl1-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .pdl1 *, .pdl1__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .pdl1__step, .pdl1__step::before { animation: none !important; transform: none !important; }
    .pdl1__step { opacity: 1 !important; }
    .pdl1__drug { opacity: 1 !important; }
    .pdl1__shield { opacity: 1 !important; }
    .pdl1__resolved { opacity: 1 !important; }
    .pdl1__harm { opacity: 0 !important; }
    .pdl1__dock-dot { opacity: 0 !important; }
  }
</style>
