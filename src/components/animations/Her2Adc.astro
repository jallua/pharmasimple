---
// Her2Adc.astro — schematic SVG + CSS animation of how an anti-HER2 antibody-drug
// conjugate (ADC, e.g. 维迪西妥单抗 / disitamab vedotin = anti-HER2 antibody + MMAE
// payload via a cleavable linker) homes to HER2 on a tumour cell, is internalised,
// and releases its cytotoxic payload inside the cell to kill it (with a bystander
// effect) — distinct from a naked antibody that only blocks signalling (需求 4, 13).
// SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard
// steps cycle on a shared 15s timeline (3s each). Under prefers-reduced-motion all
// motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 HER2 抗体偶联药物结合 HER2 阳性癌细胞,被吞入细胞后释放化疗弹头,破坏微管、定点杀死癌细胞。',
  subject,
} = Astro.props;

const steps = [
  '癌细胞表面高表达 HER2「门牌」',
  '维迪西妥单抗是「抗体 + 化疗弹头(MMAE)」的 ADC',
  '抗体像导航,精准贴上 HER2 阳性癌细胞',
  '连药被癌细胞吞入,在细胞内释放弹头',
  '弹头破坏微管、杀死癌细胞(并波及邻近癌细胞)',
];
---

<div class="adc">
  <svg class="adc__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="adc__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="adc__t adc__t--organ" x="36" y="214" text-anchor="start">癌细胞(HER2 阳性)</text>
    <rect class="adc__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="adc__t adc__t--small" x="208" y="126" text-anchor="middle">HER2</text>

    <g class="adc__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="adc__t adc__t--harm" x="208" y="66" text-anchor="middle">HER2 高表达 · 快生长</text>
    </g>

    <text class="adc__t adc__t--legend" x="86" y="30" text-anchor="middle">ADC = 抗体 + 化疗弹头</text>

    <g class="adc__toxin">
      <circle cx="150" cy="186" r="5" />
      <circle cx="256" cy="186" r="5" />
      <circle cx="120" cy="200" r="5" />
    </g>

    <circle class="adc__dock-dot" cx="208" cy="140" r="9" />

    <g class="adc__drug">
      <path class="adc__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <circle class="adc__payload" cx="196" cy="192" r="5" />
      <circle class="adc__payload" cx="208" cy="202" r="5" />
      <circle class="adc__payload" cx="220" cy="192" r="5" />
      <text class="adc__t adc__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 HER2 ADC'}</text>
    </g>

    <g class="adc__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="adc__t adc__t--shield" x="208" y="150" text-anchor="middle">释放弹头</text>
    </g>

    <g class="adc__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="adc__t adc__t--resolved" x="279" y="50" text-anchor="middle">癌细胞被杀死</text>
    </g>
  </svg>

  <ol class="adc__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="adc__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .adc {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .adc__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .adc__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .adc__receptor { fill: #64748b; }
  .adc__t { fill: #1e293b; font-size: 13px; }
  .adc__t--organ { fill: #475569; font-size: 12px; }
  .adc__t--small { font-size: 11px; fill: #475569; }
  .adc__t--legend { font-size: 10px; fill: #b91c1c; }
  .adc__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .adc__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .adc__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .adc__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .adc__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .adc__payload { fill: #ef4444; stroke: #991b1b; stroke-width: 1.5; }
  .adc__toxin circle { fill: #ef4444; stroke: #991b1b; stroke-width: 1.5; }
  .adc__toxin { opacity: 0; transform-box: fill-box; transform-origin: center; animation: adc-pop var(--dur) infinite; }
  .adc__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .adc__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: adc-inflame var(--dur) infinite; }
  .adc__dock-dot { fill: #5eead4; stroke: #0f766e; stroke-width: 1.5; opacity: 0; animation: adc-dock var(--dur) infinite; }
  .adc__drug { opacity: 0; animation: adc-bind var(--dur) infinite; }
  .adc__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .adc__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: adc-pop var(--dur) infinite; }
  .adc__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .adc__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: adc-pop-late var(--dur) infinite; }
  .adc__steps { counter-reset: adcstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .adc__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: adc-step var(--dur) infinite; }
  .adc__step::before { counter-increment: adcstep; content: counter(adcstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: adc-badge var(--dur) infinite; }
  .adc__step:nth-child(1), .adc__step:nth-child(1)::before { animation-delay: 0s; }
  .adc__step:nth-child(2), .adc__step:nth-child(2)::before { animation-delay: 3s; }
  .adc__step:nth-child(3), .adc__step:nth-child(3)::before { animation-delay: 6s; }
  .adc__step:nth-child(4), .adc__step:nth-child(4)::before { animation-delay: 9s; }
  .adc__step:nth-child(5), .adc__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes adc-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes adc-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes adc-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes adc-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes adc-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes adc-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes adc-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .adc *, .adc__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .adc__step, .adc__step::before { animation: none !important; transform: none !important; }
    .adc__step { opacity: 1 !important; }
    .adc__drug { opacity: 1 !important; }
    .adc__shield { opacity: 1 !important; }
    .adc__resolved { opacity: 1 !important; }
    .adc__toxin { opacity: 1 !important; }
    .adc__harm { opacity: 0 !important; }
    .adc__dock-dot { opacity: 0 !important; }
  }
</style>