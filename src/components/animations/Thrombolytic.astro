---
// Thrombolytic.astro — schematic, self-contained SVG + CSS animation of how a
// thrombolytic / plasminogen activator (e.g. 尿激酶原 / prourokinase) activates
// plasminogen into plasmin, which cuts apart the fibrin mesh of the clot blocking
// a coronary artery, so the clot dissolves and blood flow is restored in acute
// myocardial infarction (需求 4, 13). SCHEMATIC labelled shapes, inline SVG +
// scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s timeline
// (3s each). Under prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示溶栓药激活血液中的纤溶酶原生成纤溶酶,剪断血栓的纤维蛋白网,堵塞的血栓溶解、血流恢复。',
  subject,
} = Astro.props;

const steps = [
  '冠状动脉里形成血栓,堵住血流(心梗)',
  '血栓的主要成分是纤维蛋白“网”',
  '尿激酶原把血里的纤溶酶原激活成纤溶酶',
  '纤溶酶像剪刀,剪断血栓的纤维蛋白网',
  '血栓溶解,血流恢复',
];
---

<div class="thr">
  <svg class="thr__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="thr__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="thr__t thr__t--organ" x="36" y="196" text-anchor="start">冠状动脉</text>
    <rect class="thr__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="thr__t thr__t--small" x="208" y="126" text-anchor="middle">纤溶酶原</text>

    <g class="thr__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="thr__t thr__t--harm" x="208" y="66" text-anchor="middle">血栓堵塞 · 心肌缺血</text>
    </g>

    <g class="thr__dots">
      <circle class="thr__clot" cx="70" cy="52" r="10" />
      <circle class="thr__clot" cx="118" cy="36" r="10" />
      <circle class="thr__clot" cx="96" cy="82" r="10" />
      <text class="thr__t thr__t--small" x="96" y="16" text-anchor="middle">纤维蛋白(血栓)</text>
    </g>

    <circle class="thr__dock-dot" cx="208" cy="140" r="9" />

    <g class="thr__drug">
      <rect class="thr__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="thr__t thr__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '尿激酶原'}</text>
    </g>

    <g class="thr__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="thr__t thr__t--shield" x="208" y="150" text-anchor="middle">启动溶栓</text>
    </g>

    <g class="thr__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="thr__t thr__t--resolved" x="275" y="50" text-anchor="middle">血栓溶解 · 血流恢复</text>
    </g>
  </svg>

  <ol class="thr__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="thr__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .thr {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .thr__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .thr__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .thr__receptor { fill: #64748b; }
  .thr__t { fill: #1e293b; font-size: 13px; }
  .thr__t--organ { fill: #475569; font-size: 12px; }
  .thr__t--small { font-size: 11px; fill: #475569; }
  .thr__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .thr__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .thr__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .thr__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .thr__clot { fill: #ef4444; stroke: #7f1d1d; stroke-width: 1.5; }
  .thr__dots { animation: thr-drift var(--dur) infinite; }
  .thr__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .thr__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: thr-inflame var(--dur) infinite; }
  .thr__dock-dot { fill: #ef4444; stroke: #7f1d1d; stroke-width: 1.5; opacity: 0; animation: thr-dock var(--dur) infinite; }
  .thr__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .thr__drug { opacity: 0; animation: thr-bind var(--dur) infinite; }
  .thr__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .thr__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: thr-pop var(--dur) infinite; }
  .thr__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .thr__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: thr-pop-late var(--dur) infinite; }
  .thr__steps { counter-reset: thrstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .thr__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: thr-step var(--dur) infinite; }
  .thr__step::before { counter-increment: thrstep; content: counter(thrstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: thr-badge var(--dur) infinite; }
  .thr__step:nth-child(1), .thr__step:nth-child(1)::before { animation-delay: 0s; }
  .thr__step:nth-child(2), .thr__step:nth-child(2)::before { animation-delay: 3s; }
  .thr__step:nth-child(3), .thr__step:nth-child(3)::before { animation-delay: 6s; }
  .thr__step:nth-child(4), .thr__step:nth-child(4)::before { animation-delay: 9s; }
  .thr__step:nth-child(5), .thr__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes thr-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes thr-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes thr-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes thr-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes thr-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes thr-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes thr-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes thr-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .thr *, .thr__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .thr__step, .thr__step::before { animation: none !important; transform: none !important; }
    .thr__step { opacity: 1 !important; }
    .thr__drug { opacity: 1 !important; }
    .thr__shield { opacity: 1 !important; }
    .thr__resolved { opacity: 1 !important; }
    .thr__harm { opacity: 0 !important; }
    .thr__dock-dot { opacity: 0 !important; }
  }
</style>