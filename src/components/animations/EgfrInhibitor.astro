---
// EgfrInhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// EGFR tyrosine-kinase inhibitor (e.g. 埃克替尼 / icotinib) switches off the
// overactive EGFR "growth switch" on a lung-cancer cell so the "divide" signal
// is cut and the cell stops proliferating (需求 4, 13). SCHEMATIC labelled
// shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on
// a shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops
// and the diagram freezes on a coherent end-state (drug capping EGFR, growth
// signal cut, proliferation stopped).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 EGFR 抑制剂卡住肺癌细胞的 EGFR 生长开关,切断"快分裂"信号,使癌细胞停止增殖。',
  subject,
} = Astro.props;

const steps = [
  '肺癌细胞的 EGFR(生长开关)过度活跃',
  'EGFR 不停发出"快分裂"的信号',
  '这个药卡住 EGFR 开关',
  '"快分裂"的信号被切断',
  '癌细胞停止增殖',
];
---

<div class="egfr">
  <svg class="egfr__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="egfr__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="egfr__t egfr__t--organ" x="36" y="196" text-anchor="start">肺癌细胞</text>
    <rect class="egfr__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="egfr__t egfr__t--small" x="208" y="126" text-anchor="middle">EGFR 生长开关</text>

    <g class="egfr__grow">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="egfr__t egfr__t--grow" x="208" y="66" text-anchor="middle">催癌细胞不停分裂</text>
    </g>

    <g class="egfr__dots">
      <circle class="egfr__lig" cx="70" cy="52" r="10" />
      <circle class="egfr__lig" cx="118" cy="36" r="10" />
      <circle class="egfr__lig" cx="96" cy="82" r="10" />
      <text class="egfr__t egfr__t--small" x="96" y="16" text-anchor="middle">生长因子(EGF)</text>
    </g>

    <circle class="egfr__dock-dot" cx="208" cy="140" r="9" />

    <g class="egfr__drug">
      <rect class="egfr__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="egfr__t egfr__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'EGFR 抑制剂'}</text>
    </g>

    <g class="egfr__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="egfr__t egfr__t--shield" x="208" y="150" text-anchor="middle">开关关闭</text>
    </g>

    <g class="egfr__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="egfr__t egfr__t--resolved" x="283" y="50" text-anchor="middle">癌细胞停止增殖</text>
    </g>
  </svg>

  <ol class="egfr__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="egfr__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .egfr {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .egfr__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .egfr__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .egfr__receptor { fill: #64748b; }
  .egfr__t { fill: #1e293b; font-size: 13px; }
  .egfr__t--organ { fill: #475569; font-size: 12px; }
  .egfr__t--small { font-size: 11px; fill: #475569; }
  .egfr__t--grow { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .egfr__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .egfr__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .egfr__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .egfr__lig { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; }
  .egfr__dots { animation: egfr-drift var(--dur) infinite; }
  .egfr__grow polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .egfr__grow { opacity: 0; transform-box: fill-box; transform-origin: center; animation: egfr-inflame var(--dur) infinite; }
  .egfr__dock-dot { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; opacity: 0; animation: egfr-dock var(--dur) infinite; }
  .egfr__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .egfr__drug { opacity: 0; animation: egfr-bind var(--dur) infinite; }
  .egfr__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .egfr__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: egfr-pop var(--dur) infinite; }
  .egfr__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .egfr__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: egfr-pop-late var(--dur) infinite; }
  .egfr__steps { counter-reset: egfrstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .egfr__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: egfr-step var(--dur) infinite; }
  .egfr__step::before { counter-increment: egfrstep; content: counter(egfrstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: egfr-badge var(--dur) infinite; }
  .egfr__step:nth-child(1), .egfr__step:nth-child(1)::before { animation-delay: 0s; }
  .egfr__step:nth-child(2), .egfr__step:nth-child(2)::before { animation-delay: 3s; }
  .egfr__step:nth-child(3), .egfr__step:nth-child(3)::before { animation-delay: 6s; }
  .egfr__step:nth-child(4), .egfr__step:nth-child(4)::before { animation-delay: 9s; }
  .egfr__step:nth-child(5), .egfr__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes egfr-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes egfr-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes egfr-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes egfr-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes egfr-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes egfr-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes egfr-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes egfr-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .egfr *, .egfr__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .egfr__step, .egfr__step::before { animation: none !important; transform: none !important; }
    .egfr__step { opacity: 1 !important; }
    .egfr__drug { opacity: 1 !important; }
    .egfr__shield { opacity: 1 !important; }
    .egfr__resolved { opacity: 1 !important; }
    .egfr__grow { opacity: 0 !important; }
    .egfr__dock-dot { opacity: 0 !important; }
  }
</style>
