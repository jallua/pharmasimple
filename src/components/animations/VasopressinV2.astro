---
// VasopressinV2.astro — schematic, self-contained SVG + CSS animation of how a
// vasopressin V2-receptor agonist (去氨加压素 / desmopressin, DDAVP) activates
// the kidney tubule's V2 receptor and opens water channels, so the kidney
// reabsorbs more water and urine output falls (需求 4, 13). SCHEMATIC labelled
// shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on
// a shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops
// and the diagram freezes on a coherent end-state.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示去氨加压素激活肾小管的 V2 受体、打开水通道,肾脏多重吸收水分、尿量减少。',
  subject,
} = Astro.props;

const steps = [
  '缺少抗利尿激素时,肾脏"留不住水"',
  '尿又多又稀,口渴、夜间尿床',
  '去氨加压素激活肾小管的 V2 受体',
  '细胞打开"水通道"(水通道蛋白)',
  '水被重吸收,尿量减少、尿更浓',
];
---

<div class="dsm">
  <svg class="dsm__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="dsm__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="dsm__t dsm__t--organ" x="36" y="196" text-anchor="start">肾小管细胞</text>
    <rect class="dsm__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="dsm__t dsm__t--small" x="208" y="126" text-anchor="middle">V2 受体</text>

    <g class="dsm__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="dsm__t dsm__t--inflam" x="208" y="66" text-anchor="middle">尿多又稀 · 口渴</text>
    </g>

    <g class="dsm__dots">
      <circle class="dsm__lig" cx="70" cy="52" r="10" />
      <circle class="dsm__lig" cx="118" cy="36" r="10" />
      <circle class="dsm__lig" cx="96" cy="82" r="10" />
      <text class="dsm__t dsm__t--small" x="96" y="16" text-anchor="middle">水分子</text>
    </g>

    <circle class="dsm__dock-dot" cx="208" cy="140" r="9" />

    <g class="dsm__drug">
      <rect class="dsm__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="dsm__t dsm__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '去氨加压素'}</text>
    </g>

    <g class="dsm__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="dsm__t dsm__t--shield" x="208" y="150" text-anchor="middle">打开水通道</text>
    </g>

    <g class="dsm__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="dsm__t dsm__t--resolved" x="275" y="50" text-anchor="middle">水被重吸收 · 尿量减少</text>
    </g>
  </svg>

  <ol class="dsm__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="dsm__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .dsm {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .dsm__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .dsm__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .dsm__receptor { fill: #64748b; }
  .dsm__t { fill: #1e293b; font-size: 13px; }
  .dsm__t--organ { fill: #475569; font-size: 12px; }
  .dsm__t--small { font-size: 11px; fill: #475569; }
  .dsm__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .dsm__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .dsm__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .dsm__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .dsm__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .dsm__dots { animation: dsm-drift var(--dur) infinite; }
  .dsm__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .dsm__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: dsm-inflame var(--dur) infinite; }
  .dsm__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: dsm-dock var(--dur) infinite; }
  .dsm__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .dsm__drug { opacity: 0; animation: dsm-bind var(--dur) infinite; }
  .dsm__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .dsm__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: dsm-pop var(--dur) infinite; }
  .dsm__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .dsm__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: dsm-pop-late var(--dur) infinite; }
  .dsm__steps { counter-reset: dsmstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .dsm__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: dsm-step var(--dur) infinite; }
  .dsm__step::before { counter-increment: dsmstep; content: counter(dsmstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: dsm-badge var(--dur) infinite; }
  .dsm__step:nth-child(1), .dsm__step:nth-child(1)::before { animation-delay: 0s; }
  .dsm__step:nth-child(2), .dsm__step:nth-child(2)::before { animation-delay: 3s; }
  .dsm__step:nth-child(3), .dsm__step:nth-child(3)::before { animation-delay: 6s; }
  .dsm__step:nth-child(4), .dsm__step:nth-child(4)::before { animation-delay: 9s; }
  .dsm__step:nth-child(5), .dsm__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes dsm-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes dsm-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes dsm-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes dsm-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes dsm-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes dsm-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes dsm-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes dsm-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .dsm *, .dsm__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .dsm__step, .dsm__step::before { animation: none !important; transform: none !important; }
    .dsm__step { opacity: 1 !important; }
    .dsm__drug { opacity: 1 !important; }
    .dsm__shield { opacity: 1 !important; }
    .dsm__resolved { opacity: 1 !important; }
    .dsm__inflam { opacity: 0 !important; }
    .dsm__dock-dot { opacity: 0 !important; }
  }
</style>
