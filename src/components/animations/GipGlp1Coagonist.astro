---
// GipGlp1Coagonist.astro — schematic SVG + CSS animation of how a dual GIP/GLP-1
// receptor co-agonist (e.g. 替尔泊肽 / tirzepatide) uses a single molecule to
// activate BOTH the GIP receptor and the GLP-1 receptor, so glucose-dependent
// insulin release and appetite suppression run through two incretin pathways at
// once — stronger than a GLP-1-only agonist (需求 4, 13). SCHEMATIC labelled
// shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on
// a shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示替尔泊肽用一个分子同时激活 GIP 与 GLP-1 两种受体,双通道促进胰岛素分泌、降低食欲,血糖与体重双双下降。',
  subject,
} = Astro.props;

const steps = [
  '餐后血糖升高、常伴超重',
  '肠道靠 GLP-1、GIP 两种"肠促胰素"提醒降糖、带来饱腹感',
  '替尔泊肽一个分子,同时激活 GIP 与 GLP-1 两种受体',
  '双通道一起发力:胰岛素分泌更多、食欲压得更低',
  '血糖下降,体重也明显下降(强于只激活一种)',
];
---

<div class="gip">
  <svg class="gip__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="gip__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="gip__t gip__t--organ" x="36" y="196" text-anchor="start">胰腺 β 细胞 / 大脑</text>

    <rect class="gip__receptor" x="132" y="132" width="24" height="24" rx="3" />
    <text class="gip__t gip__t--small" x="144" y="126" text-anchor="middle">GIP 受体</text>
    <rect class="gip__receptor" x="236" y="132" width="24" height="24" rx="3" />
    <text class="gip__t gip__t--small" x="248" y="126" text-anchor="middle">GLP-1 受体</text>

    <g class="gip__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="gip__t gip__t--harm" x="208" y="66" text-anchor="middle">餐后血糖高 · 超重</text>
    </g>

    <g class="gip__dots">
      <circle class="gip__lig" cx="70" cy="52" r="10" />
      <circle class="gip__lig" cx="112" cy="34" r="10" />
      <circle class="gip__lig" cx="96" cy="82" r="10" />
      <text class="gip__t gip__t--small" x="88" y="16" text-anchor="middle">GLP-1 / GIP 信号</text>
    </g>

    <circle class="gip__dock-dot" cx="144" cy="140" r="8" />
    <circle class="gip__dock-dot" cx="248" cy="140" r="8" />

    <g class="gip__drug">
      <line class="gip__link" x1="200" y1="146" x2="156" y2="146" />
      <line class="gip__link" x1="216" y1="146" x2="236" y2="146" />
      <rect class="gip__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="gip__t gip__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '替尔泊肽'}</text>
    </g>

    <g class="gip__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="gip__t gip__t--shield" x="208" y="150" text-anchor="middle">双受体激活</text>
    </g>

    <g class="gip__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="gip__t gip__t--resolved" x="275" y="50" text-anchor="middle">血糖 · 体重双降</text>
    </g>
  </svg>

  <ol class="gip__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="gip__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .gip {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .gip__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .gip__cell { fill: #fef3c7; stroke: #f59e0b; stroke-width: 2; }
  .gip__receptor { fill: #64748b; }
  .gip__t { fill: #1e293b; font-size: 13px; }
  .gip__t--organ { fill: #475569; font-size: 12px; }
  .gip__t--small { font-size: 11px; fill: #475569; }
  .gip__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .gip__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .gip__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .gip__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .gip__lig { fill: #34d399; stroke: #059669; stroke-width: 1.5; }
  .gip__dots { animation: gip-drift var(--dur) infinite; }
  .gip__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .gip__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gip-inflame var(--dur) infinite; }
  .gip__dock-dot { fill: #34d399; stroke: #059669; stroke-width: 1.5; opacity: 0; animation: gip-dock var(--dur) infinite; }
  .gip__link { stroke: #0f766e; stroke-width: 2; stroke-dasharray: 3 3; }
  .gip__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .gip__drug { opacity: 0; animation: gip-bind var(--dur) infinite; }
  .gip__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .gip__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gip-pop var(--dur) infinite; }
  .gip__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .gip__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gip-pop-late var(--dur) infinite; }
  .gip__steps { counter-reset: gipstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .gip__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: gip-step var(--dur) infinite; }
  .gip__step::before { counter-increment: gipstep; content: counter(gipstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: gip-badge var(--dur) infinite; }
  .gip__step:nth-child(1), .gip__step:nth-child(1)::before { animation-delay: 0s; }
  .gip__step:nth-child(2), .gip__step:nth-child(2)::before { animation-delay: 3s; }
  .gip__step:nth-child(3), .gip__step:nth-child(3)::before { animation-delay: 6s; }
  .gip__step:nth-child(4), .gip__step:nth-child(4)::before { animation-delay: 9s; }
  .gip__step:nth-child(5), .gip__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes gip-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes gip-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes gip-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes gip-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes gip-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes gip-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes gip-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes gip-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .gip *, .gip__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .gip__step, .gip__step::before { animation: none !important; transform: none !important; }
    .gip__step { opacity: 1 !important; }
    .gip__drug { opacity: 1 !important; }
    .gip__shield { opacity: 1 !important; }
    .gip__resolved { opacity: 1 !important; }
    .gip__harm { opacity: 0 !important; }
    .gip__dock-dot { opacity: 0 !important; }
  }
</style>