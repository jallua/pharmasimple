---
// Retinoid.astro — schematic, self-contained SVG + CSS animation of how a topical
// retinoid (e.g. 阿达帕林 / adapalene) binds the skin's retinoic acid receptors
// (RAR), normalises the turnover of follicular keratinocytes so pores stop
// clogging, and calms inflammation, so acne (comedones and pimples) subsides
// (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO JavaScript.
// Five storyboard steps cycle on a shared 15s timeline (3s each). Under
// prefers-reduced-motion all motion stops and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示外用维 A 酸类结合皮肤视黄酸受体,让角质正常更新脱落、毛孔通畅、炎症减轻,痘痘减少。',
  subject,
} = Astro.props;

const steps = [
  '毛囊口角质细胞过度堆积、堵住毛孔',
  '皮脂淤积、细菌繁殖,形成粉刺和痘痘',
  '外用维 A 酸类结合皮肤的视黄酸受体(RAR)',
  '让角质正常更新脱落、并减轻炎症',
  '毛孔重新通畅,粉刺和痘痘减少',
];
---

<div class="ret">
  <svg class="ret__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="ret__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="ret__t ret__t--organ" x="36" y="196" text-anchor="start">皮肤(毛囊皮脂腺)</text>
    <rect class="ret__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="ret__t ret__t--small" x="208" y="126" text-anchor="middle">视黄酸受体(RAR)</text>

    <g class="ret__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="ret__t ret__t--inflam" x="208" y="66" text-anchor="middle">毛孔堵塞 · 粉刺痘痘</text>
    </g>

    <g class="ret__dots">
      <circle class="ret__lig" cx="70" cy="52" r="10" />
      <circle class="ret__lig" cx="118" cy="36" r="10" />
      <circle class="ret__lig" cx="96" cy="82" r="10" />
      <text class="ret__t ret__t--small" x="96" y="16" text-anchor="middle">角质细胞(堆积)</text>
    </g>

    <circle class="ret__dock-dot" cx="208" cy="140" r="9" />

    <g class="ret__drug">
      <rect class="ret__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="ret__t ret__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '外用维 A 酸类'}</text>
    </g>

    <g class="ret__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="ret__t ret__t--shield" x="208" y="150" text-anchor="middle">调节更新 · 抗炎</text>
    </g>

    <g class="ret__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="ret__t ret__t--resolved" x="275" y="50" text-anchor="middle">毛孔通畅 · 痘痘减少</text>
    </g>
  </svg>

  <ol class="ret__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="ret__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .ret {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .ret__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .ret__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .ret__receptor { fill: #64748b; }
  .ret__t { fill: #1e293b; font-size: 13px; }
  .ret__t--organ { fill: #475569; font-size: 12px; }
  .ret__t--small { font-size: 11px; fill: #475569; }
  .ret__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .ret__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .ret__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .ret__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .ret__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .ret__dots { animation: ret-drift var(--dur) infinite; }
  .ret__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .ret__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ret-inflame var(--dur) infinite; }
  .ret__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: ret-dock var(--dur) infinite; }
  .ret__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .ret__drug { opacity: 0; animation: ret-bind var(--dur) infinite; }
  .ret__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .ret__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ret-pop var(--dur) infinite; }
  .ret__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .ret__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ret-pop-late var(--dur) infinite; }
  .ret__steps { counter-reset: retstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .ret__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: ret-step var(--dur) infinite; }
  .ret__step::before { counter-increment: retstep; content: counter(retstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: ret-badge var(--dur) infinite; }
  .ret__step:nth-child(1), .ret__step:nth-child(1)::before { animation-delay: 0s; }
  .ret__step:nth-child(2), .ret__step:nth-child(2)::before { animation-delay: 3s; }
  .ret__step:nth-child(3), .ret__step:nth-child(3)::before { animation-delay: 6s; }
  .ret__step:nth-child(4), .ret__step:nth-child(4)::before { animation-delay: 9s; }
  .ret__step:nth-child(5), .ret__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes ret-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes ret-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes ret-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes ret-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes ret-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes ret-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes ret-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes ret-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .ret *, .ret__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .ret__step, .ret__step::before { animation: none !important; transform: none !important; }
    .ret__step { opacity: 1 !important; }
    .ret__drug { opacity: 1 !important; }
    .ret__shield { opacity: 1 !important; }
    .ret__resolved { opacity: 1 !important; }
    .ret__inflam { opacity: 0 !important; }
    .ret__dock-dot { opacity: 0 !important; }
  }
</style>
