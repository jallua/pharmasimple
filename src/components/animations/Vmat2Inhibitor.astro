---
// Vmat2Inhibitor.astro — schematic, self-contained SVG + CSS animation of how a
// VMAT2 inhibitor (e.g. 缬苯那嗪 / valbenazine) puts the brakes on the VMAT2
// "loader" that packs dopamine into synaptic vesicles, so less dopamine is
// loaded and released and the excessive dopamine signalling behind tardive
// dyskinesia's involuntary movements settles (需求 4, 13). SCHEMATIC labelled
// shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on
// a shared 15s timeline (3s each). Under prefers-reduced-motion all motion stops
// and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 VMAT2 抑制剂给"把多巴胺装进囊泡"的搬运工踩刹车,多巴胺释放减少,不自主动作平息。',
  subject,
} = Astro.props;

const steps = [
  'VMAT2 把多巴胺装进小囊泡,准备释放',
  '多巴胺信号过强,出现不自主动作',
  '这个药给 VMAT2 搬运工踩刹车',
  '装进囊泡的多巴胺变少、释放减少',
  '多巴胺信号回落,不自主动作平息',
];
---

<div class="vmat">
  <svg class="vmat__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="vmat__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="vmat__t vmat__t--organ" x="36" y="196" text-anchor="start">多巴胺神经末梢</text>
    <rect class="vmat__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="vmat__t vmat__t--small" x="208" y="126" text-anchor="middle">VMAT2 搬运工</text>

    <g class="vmat__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="vmat__t vmat__t--inflam" x="208" y="66" text-anchor="middle">不自主动作</text>
    </g>

    <g class="vmat__dots">
      <circle class="vmat__lig" cx="70" cy="52" r="10" />
      <circle class="vmat__lig" cx="118" cy="36" r="10" />
      <circle class="vmat__lig" cx="96" cy="82" r="10" />
      <text class="vmat__t vmat__t--small" x="96" y="16" text-anchor="middle">多巴胺</text>
    </g>

    <circle class="vmat__dock-dot" cx="208" cy="140" r="9" />

    <g class="vmat__drug">
      <rect class="vmat__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="vmat__t vmat__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'VMAT2 抑制剂'}</text>
    </g>

    <g class="vmat__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="vmat__t vmat__t--shield" x="208" y="150" text-anchor="middle">VMAT2 被抑制</text>
    </g>

    <g class="vmat__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="vmat__t vmat__t--resolved" x="275" y="50" text-anchor="middle">多巴胺释放减少 · 动作平息</text>
    </g>
  </svg>

  <ol class="vmat__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="vmat__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .vmat {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .vmat__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .vmat__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .vmat__receptor { fill: #64748b; }
  .vmat__t { fill: #1e293b; font-size: 13px; }
  .vmat__t--organ { fill: #475569; font-size: 12px; }
  .vmat__t--small { font-size: 11px; fill: #475569; }
  .vmat__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .vmat__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .vmat__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .vmat__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .vmat__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .vmat__dots { animation: vmat-drift var(--dur) infinite; }
  .vmat__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .vmat__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vmat-inflame var(--dur) infinite; }
  .vmat__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: vmat-dock var(--dur) infinite; }
  .vmat__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .vmat__drug { opacity: 0; animation: vmat-bind var(--dur) infinite; }
  .vmat__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .vmat__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vmat-pop var(--dur) infinite; }
  .vmat__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .vmat__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vmat-pop-late var(--dur) infinite; }
  .vmat__steps { counter-reset: vmatstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .vmat__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: vmat-step var(--dur) infinite; }
  .vmat__step::before { counter-increment: vmatstep; content: counter(vmatstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: vmat-badge var(--dur) infinite; }
  .vmat__step:nth-child(1), .vmat__step:nth-child(1)::before { animation-delay: 0s; }
  .vmat__step:nth-child(2), .vmat__step:nth-child(2)::before { animation-delay: 3s; }
  .vmat__step:nth-child(3), .vmat__step:nth-child(3)::before { animation-delay: 6s; }
  .vmat__step:nth-child(4), .vmat__step:nth-child(4)::before { animation-delay: 9s; }
  .vmat__step:nth-child(5), .vmat__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes vmat-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes vmat-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes vmat-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes vmat-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes vmat-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes vmat-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes vmat-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes vmat-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .vmat *, .vmat__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .vmat__step, .vmat__step::before { animation: none !important; transform: none !important; }
    .vmat__step { opacity: 1 !important; }
    .vmat__drug { opacity: 1 !important; }
    .vmat__shield { opacity: 1 !important; }
    .vmat__resolved { opacity: 1 !important; }
    .vmat__inflam { opacity: 0 !important; }
    .vmat__dock-dot { opacity: 0 !important; }
  }
</style>
