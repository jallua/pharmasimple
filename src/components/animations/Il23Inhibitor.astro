---
// Il23Inhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// anti-IL-23 antibody (e.g. 替瑞奇珠单抗 / tildrakizumab) intercepts the IL-23
// cytokine that drives psoriatic (Th17-type) inflammation, so it can no longer
// reach its receptor and the skin inflammation subsides (需求 4, 13). SCHEMATIC
// labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps
// cycle on a shared 15s timeline (3s each). Under prefers-reduced-motion all
// motion stops and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 IL-23 抗体拦下 IL-23 炎症信号,使其无法激活受体,银屑病等皮肤炎症随之消退。',
  subject,
} = Astro.props;

const steps = [
  'IL-23 信号过多,驱动银屑病炎症',
  'IL-23 接上受体,放大炎症(红斑、鳞屑)',
  '这个抗体把 IL-23 拦下',
  'IL-23 到不了受体',
  '炎症消退,皮损改善',
];
---

<div class="il23">
  <svg class="il23__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="il23__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="il23__t il23__t--organ" x="36" y="196" text-anchor="start">皮肤 / 免疫细胞</text>
    <rect class="il23__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="il23__t il23__t--small" x="208" y="126" text-anchor="middle">IL-23 受体</text>

    <g class="il23__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="il23__t il23__t--inflam" x="208" y="66" text-anchor="middle">银屑病炎症 · 红斑鳞屑</text>
    </g>

    <g class="il23__dots">
      <circle class="il23__lig" cx="70" cy="52" r="10" />
      <circle class="il23__lig" cx="118" cy="36" r="10" />
      <circle class="il23__lig" cx="96" cy="82" r="10" />
      <text class="il23__t il23__t--small" x="96" y="16" text-anchor="middle">IL-23 信号</text>
    </g>

    <circle class="il23__dock-dot" cx="208" cy="140" r="9" />

    <g class="il23__drug">
      <path class="il23__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <text class="il23__t il23__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 IL-23 抗体'}</text>
    </g>

    <g class="il23__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="il23__t il23__t--shield" x="208" y="150" text-anchor="middle">拦下</text>
    </g>

    <g class="il23__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="il23__t il23__t--resolved" x="283" y="50" text-anchor="middle">皮损改善</text>
    </g>
  </svg>

  <ol class="il23__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="il23__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .il23 {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .il23__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .il23__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .il23__receptor { fill: #64748b; }
  .il23__t { fill: #1e293b; font-size: 13px; }
  .il23__t--organ { fill: #475569; font-size: 12px; }
  .il23__t--small { font-size: 11px; fill: #475569; }
  .il23__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .il23__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .il23__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .il23__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .il23__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .il23__dots { animation: il23-drift var(--dur) infinite; }
  .il23__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .il23__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: il23-inflame var(--dur) infinite; }
  .il23__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: il23-dock var(--dur) infinite; }
  .il23__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .il23__drug { opacity: 0; animation: il23-bind var(--dur) infinite; }
  .il23__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .il23__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: il23-pop var(--dur) infinite; }
  .il23__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .il23__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: il23-pop-late var(--dur) infinite; }
  .il23__steps { counter-reset: il23step; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .il23__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: il23-step var(--dur) infinite; }
  .il23__step::before { counter-increment: il23step; content: counter(il23step); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: il23-badge var(--dur) infinite; }
  .il23__step:nth-child(1), .il23__step:nth-child(1)::before { animation-delay: 0s; }
  .il23__step:nth-child(2), .il23__step:nth-child(2)::before { animation-delay: 3s; }
  .il23__step:nth-child(3), .il23__step:nth-child(3)::before { animation-delay: 6s; }
  .il23__step:nth-child(4), .il23__step:nth-child(4)::before { animation-delay: 9s; }
  .il23__step:nth-child(5), .il23__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes il23-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes il23-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes il23-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes il23-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes il23-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes il23-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes il23-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes il23-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .il23 *, .il23__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .il23__step, .il23__step::before { animation: none !important; transform: none !important; }
    .il23__step { opacity: 1 !important; }
    .il23__drug { opacity: 1 !important; }
    .il23__shield { opacity: 1 !important; }
    .il23__resolved { opacity: 1 !important; }
    .il23__inflam { opacity: 0 !important; }
    .il23__dock-dot { opacity: 0 !important; }
  }
</style>
