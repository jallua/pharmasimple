---
// IntegrinBlocker.astro — schematic, self-contained SVG + CSS animation of how an
// anti-α4-integrin antibody (e.g. 那他珠单抗 / natalizumab) caps the α4 integrin
// "grappling hook" on immune cells so they can no longer stick to the vessel
// wall and cross into the brain/spinal cord, reducing CNS inflammation in
// multiple sclerosis (需求 4, 13). SCHEMATIC labelled shapes, inline SVG +
// scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes on a coherent end-state (antibody capping the integrin,
// immune cell blocked, nerve inflammation reduced).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 α4 整合素抗体盖住免疫细胞的整合素抓钩,使其无法黏附血管壁、进入脑脊髓,从而减轻神经炎症。',
  subject,
} = Astro.props;

const steps = [
  '多发性硬化:免疫细胞想钻进脑和脊髓"闹事"',
  '它用表面的 α4 整合素"抓钩"扒住血管壁往里钻',
  '这个抗体盖住 α4 整合素抓钩',
  '免疫细胞扒不住、钻不进去了',
  '脑脊髓的炎症与神经损伤减轻',
];
---

<div class="intg">
  <svg class="intg__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="intg__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="intg__t intg__t--organ" x="36" y="196" text-anchor="start">免疫细胞(白细胞)</text>
    <rect class="intg__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="intg__t intg__t--small" x="208" y="126" text-anchor="middle">α4 整合素抓钩</text>

    <g class="intg__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="intg__t intg__t--harm" x="208" y="66" text-anchor="middle">钻进脑脊髓 · 炎症</text>
    </g>

    <g class="intg__dots">
      <circle class="intg__vcam" cx="70" cy="52" r="10" />
      <circle class="intg__vcam" cx="118" cy="36" r="10" />
      <circle class="intg__vcam" cx="96" cy="82" r="10" />
      <text class="intg__t intg__t--small" x="96" y="16" text-anchor="middle">血管壁着陆点</text>
    </g>

    <circle class="intg__dock-dot" cx="208" cy="140" r="9" />

    <g class="intg__drug">
      <path class="intg__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <text class="intg__t intg__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 α4 整合素抗体'}</text>
    </g>

    <g class="intg__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="intg__t intg__t--shield" x="208" y="150" text-anchor="middle">盖住</text>
    </g>

    <g class="intg__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="intg__t intg__t--resolved" x="283" y="50" text-anchor="middle">神经炎症减轻</text>
    </g>
  </svg>

  <ol class="intg__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="intg__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .intg {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .intg__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .intg__cell { fill: #eef2ff; stroke: #a5b4fc; stroke-width: 2; }
  .intg__receptor { fill: #64748b; }
  .intg__t { fill: #1e293b; font-size: 13px; }
  .intg__t--organ { fill: #475569; font-size: 12px; }
  .intg__t--small { font-size: 11px; fill: #475569; }
  .intg__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .intg__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .intg__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .intg__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .intg__vcam { fill: #60a5fa; stroke: #2563eb; stroke-width: 1.5; }
  .intg__dots { animation: intg-drift var(--dur) infinite; }
  .intg__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .intg__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: intg-inflame var(--dur) infinite; }
  .intg__dock-dot { fill: #60a5fa; stroke: #2563eb; stroke-width: 1.5; opacity: 0; animation: intg-dock var(--dur) infinite; }
  .intg__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .intg__drug { opacity: 0; animation: intg-bind var(--dur) infinite; }
  .intg__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .intg__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: intg-pop var(--dur) infinite; }
  .intg__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .intg__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: intg-pop-late var(--dur) infinite; }
  .intg__steps { counter-reset: intgstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .intg__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: intg-step var(--dur) infinite; }
  .intg__step::before { counter-increment: intgstep; content: counter(intgstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: intg-badge var(--dur) infinite; }
  .intg__step:nth-child(1), .intg__step:nth-child(1)::before { animation-delay: 0s; }
  .intg__step:nth-child(2), .intg__step:nth-child(2)::before { animation-delay: 3s; }
  .intg__step:nth-child(3), .intg__step:nth-child(3)::before { animation-delay: 6s; }
  .intg__step:nth-child(4), .intg__step:nth-child(4)::before { animation-delay: 9s; }
  .intg__step:nth-child(5), .intg__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes intg-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes intg-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes intg-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes intg-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes intg-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes intg-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes intg-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes intg-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .intg *, .intg__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .intg__step, .intg__step::before { animation: none !important; transform: none !important; }
    .intg__step { opacity: 1 !important; }
    .intg__drug { opacity: 1 !important; }
    .intg__shield { opacity: 1 !important; }
    .intg__resolved { opacity: 1 !important; }
    .intg__harm { opacity: 0 !important; }
    .intg__dock-dot { opacity: 0 !important; }
  }
</style>
