---
// Ccb.astro — schematic, self-contained SVG + CSS animation of how a calcium
// channel blocker (CCB, e.g. 氨氯地平 / amlodipine) plugs the L-type calcium
// channels on vascular smooth muscle, so calcium influx drops, the vessels
// relax and blood pressure falls (需求 4, 13). SCHEMATIC labelled shapes, inline
// SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示钙通道阻滞剂堵住血管平滑肌的 L 型钙通道,钙内流减少、血管舒张,血压随之下降。',
  subject,
} = Astro.props;

const steps = [
  '钙离子经"钙通道"涌入血管平滑肌',
  '钙一多,血管收缩、血压升高',
  '这个药堵住 L 型钙通道',
  '钙进不来,平滑肌放松',
  '血管舒张,血压随之下降',
];
---

<div class="ccb">
  <svg class="ccb__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="ccb__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="ccb__t ccb__t--organ" x="36" y="196" text-anchor="start">血管平滑肌</text>
    <rect class="ccb__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="ccb__t ccb__t--small" x="208" y="126" text-anchor="middle">L 型钙通道</text>

    <g class="ccb__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="ccb__t ccb__t--inflam" x="208" y="66" text-anchor="middle">血管收缩 · 血压升高</text>
    </g>

    <g class="ccb__dots">
      <circle class="ccb__lig" cx="70" cy="52" r="10" />
      <circle class="ccb__lig" cx="118" cy="36" r="10" />
      <circle class="ccb__lig" cx="96" cy="82" r="10" />
      <text class="ccb__t ccb__t--small" x="96" y="16" text-anchor="middle">钙离子</text>
    </g>

    <circle class="ccb__dock-dot" cx="208" cy="140" r="9" />

    <g class="ccb__drug">
      <rect class="ccb__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="ccb__t ccb__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '钙通道阻滞剂'}</text>
    </g>

    <g class="ccb__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="ccb__t ccb__t--shield" x="208" y="150" text-anchor="middle">钙通道被阻断</text>
    </g>

    <g class="ccb__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="ccb__t ccb__t--resolved" x="275" y="50" text-anchor="middle">血管舒张 · 血压下降</text>
    </g>
  </svg>

  <ol class="ccb__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="ccb__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .ccb {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .ccb__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .ccb__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .ccb__receptor { fill: #64748b; }
  .ccb__t { fill: #1e293b; font-size: 13px; }
  .ccb__t--organ { fill: #475569; font-size: 12px; }
  .ccb__t--small { font-size: 11px; fill: #475569; }
  .ccb__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .ccb__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .ccb__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .ccb__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .ccb__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .ccb__dots { animation: ccb-drift var(--dur) infinite; }
  .ccb__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .ccb__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ccb-inflame var(--dur) infinite; }
  .ccb__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: ccb-dock var(--dur) infinite; }
  .ccb__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .ccb__drug { opacity: 0; animation: ccb-bind var(--dur) infinite; }
  .ccb__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .ccb__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ccb-pop var(--dur) infinite; }
  .ccb__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .ccb__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ccb-pop-late var(--dur) infinite; }
  .ccb__steps { counter-reset: ccbstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .ccb__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: ccb-step var(--dur) infinite; }
  .ccb__step::before { counter-increment: ccbstep; content: counter(ccbstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: ccb-badge var(--dur) infinite; }
  .ccb__step:nth-child(1), .ccb__step:nth-child(1)::before { animation-delay: 0s; }
  .ccb__step:nth-child(2), .ccb__step:nth-child(2)::before { animation-delay: 3s; }
  .ccb__step:nth-child(3), .ccb__step:nth-child(3)::before { animation-delay: 6s; }
  .ccb__step:nth-child(4), .ccb__step:nth-child(4)::before { animation-delay: 9s; }
  .ccb__step:nth-child(5), .ccb__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes ccb-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes ccb-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes ccb-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes ccb-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes ccb-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes ccb-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes ccb-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes ccb-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .ccb *, .ccb__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .ccb__step, .ccb__step::before { animation: none !important; transform: none !important; }
    .ccb__step { opacity: 1 !important; }
    .ccb__drug { opacity: 1 !important; }
    .ccb__shield { opacity: 1 !important; }
    .ccb__resolved { opacity: 1 !important; }
    .ccb__inflam { opacity: 0 !important; }
    .ccb__dock-dot { opacity: 0 !important; }
  }
</style>
