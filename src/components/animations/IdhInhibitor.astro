---
// IdhInhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// IDH1 inhibitor (e.g. 艾伏尼布 / ivosidenib) switches off the mutant IDH enzyme
// that pumps out the abnormal metabolite 2-HG, releasing the block on cell
// differentiation so cancer cells mature again instead of proliferating wildly
// (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO
// JavaScript. Five storyboard steps cycle on a shared 15s timeline (3s each).
// Under prefers-reduced-motion all motion stops and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 IDH1 抑制剂关掉突变 IDH 酶、降低异常代谢物 2-HG,癌细胞恢复正常分化。',
  subject,
} = Astro.props;

const steps = [
  '突变的 IDH 酶产生异常代谢物(2-HG)',
  '2-HG 让癌细胞"卡住不分化"、乱增殖',
  '这个药抑制突变型 IDH 酶',
  '异常代谢物(2-HG)下降',
  '细胞恢复正常分化,肿瘤受控',
];
---

<div class="idh">
  <svg class="idh__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="idh__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="idh__t idh__t--organ" x="36" y="196" text-anchor="start">癌细胞(IDH 突变)</text>
    <rect class="idh__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="idh__t idh__t--small" x="208" y="126" text-anchor="middle">突变型 IDH 酶</text>

    <g class="idh__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="idh__t idh__t--inflam" x="208" y="66" text-anchor="middle">分化受阻 · 异常增殖</text>
    </g>

    <g class="idh__dots">
      <circle class="idh__lig" cx="70" cy="52" r="10" />
      <circle class="idh__lig" cx="118" cy="36" r="10" />
      <circle class="idh__lig" cx="96" cy="82" r="10" />
      <text class="idh__t idh__t--small" x="96" y="16" text-anchor="middle">2-HG(异常代谢物)</text>
    </g>

    <circle class="idh__dock-dot" cx="208" cy="140" r="9" />

    <g class="idh__drug">
      <rect class="idh__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="idh__t idh__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'IDH1 抑制剂'}</text>
    </g>

    <g class="idh__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="idh__t idh__t--shield" x="208" y="150" text-anchor="middle">抑制突变 IDH</text>
    </g>

    <g class="idh__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="idh__t idh__t--resolved" x="275" y="50" text-anchor="middle">2-HG 减少 · 细胞分化</text>
    </g>
  </svg>

  <ol class="idh__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="idh__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .idh {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .idh__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .idh__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .idh__receptor { fill: #64748b; }
  .idh__t { fill: #1e293b; font-size: 13px; }
  .idh__t--organ { fill: #475569; font-size: 12px; }
  .idh__t--small { font-size: 11px; fill: #475569; }
  .idh__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .idh__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .idh__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .idh__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .idh__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .idh__dots { animation: idh-drift var(--dur) infinite; }
  .idh__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .idh__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: idh-inflame var(--dur) infinite; }
  .idh__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: idh-dock var(--dur) infinite; }
  .idh__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .idh__drug { opacity: 0; animation: idh-bind var(--dur) infinite; }
  .idh__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .idh__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: idh-pop var(--dur) infinite; }
  .idh__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .idh__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: idh-pop-late var(--dur) infinite; }
  .idh__steps { counter-reset: idhstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .idh__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: idh-step var(--dur) infinite; }
  .idh__step::before { counter-increment: idhstep; content: counter(idhstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: idh-badge var(--dur) infinite; }
  .idh__step:nth-child(1), .idh__step:nth-child(1)::before { animation-delay: 0s; }
  .idh__step:nth-child(2), .idh__step:nth-child(2)::before { animation-delay: 3s; }
  .idh__step:nth-child(3), .idh__step:nth-child(3)::before { animation-delay: 6s; }
  .idh__step:nth-child(4), .idh__step:nth-child(4)::before { animation-delay: 9s; }
  .idh__step:nth-child(5), .idh__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes idh-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes idh-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes idh-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes idh-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes idh-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes idh-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes idh-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes idh-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .idh *, .idh__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .idh__step, .idh__step::before { animation: none !important; transform: none !important; }
    .idh__step { opacity: 1 !important; }
    .idh__drug { opacity: 1 !important; }
    .idh__shield { opacity: 1 !important; }
    .idh__resolved { opacity: 1 !important; }
    .idh__inflam { opacity: 0 !important; }
    .idh__dock-dot { opacity: 0 !important; }
  }
</style>
