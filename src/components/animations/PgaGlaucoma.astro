---
// PgaGlaucoma.astro — schematic, self-contained SVG + CSS animation of how a
// prostaglandin analogue (e.g. 曲伏前列素 / travoprost, 他氟前列素 / tafluprost)
// activates the eye's FP prostaglandin receptor to open the uveoscleral
// "drain", so aqueous humour flows out faster and intraocular pressure falls,
// protecting the optic nerve (需求 4, 13). SCHEMATIC labelled shapes, inline SVG
// + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes on a coherent end-state.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示前列腺素类似物激活眼内 FP 受体,打开房水排出通道,房水外流增加、眼压下降。',
  subject,
} = Astro.props;

const steps = [
  '房水排出不畅,眼压慢慢升高',
  '长期高眼压压迫视神经,损害视力',
  '前列腺素类似物激活眼内 FP 受体',
  '"葡萄膜巩膜"排水通道被打开',
  '房水排出增多,眼压下降、护住视神经',
];
---

<div class="pga">
  <svg class="pga__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="pga__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="pga__t pga__t--organ" x="36" y="196" text-anchor="start">眼睛(前房)</text>
    <rect class="pga__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="pga__t pga__t--small" x="208" y="126" text-anchor="middle">FP 受体</text>

    <g class="pga__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="pga__t pga__t--inflam" x="208" y="66" text-anchor="middle">眼压升高</text>
    </g>

    <g class="pga__dots">
      <circle class="pga__lig" cx="70" cy="52" r="10" />
      <circle class="pga__lig" cx="118" cy="36" r="10" />
      <circle class="pga__lig" cx="96" cy="82" r="10" />
      <text class="pga__t pga__t--small" x="96" y="16" text-anchor="middle">房水</text>
    </g>

    <circle class="pga__dock-dot" cx="208" cy="140" r="9" />

    <g class="pga__drug">
      <rect class="pga__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="pga__t pga__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '前列腺素类似物'}</text>
    </g>

    <g class="pga__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="pga__t pga__t--shield" x="208" y="150" text-anchor="middle">打开房水排水口</text>
    </g>

    <g class="pga__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="pga__t pga__t--resolved" x="275" y="50" text-anchor="middle">房水排出增加 · 眼压下降</text>
    </g>
  </svg>

  <ol class="pga__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="pga__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .pga {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .pga__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .pga__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .pga__receptor { fill: #64748b; }
  .pga__t { fill: #1e293b; font-size: 13px; }
  .pga__t--organ { fill: #475569; font-size: 12px; }
  .pga__t--small { font-size: 11px; fill: #475569; }
  .pga__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .pga__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .pga__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .pga__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .pga__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .pga__dots { animation: pga-drift var(--dur) infinite; }
  .pga__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .pga__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pga-inflame var(--dur) infinite; }
  .pga__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: pga-dock var(--dur) infinite; }
  .pga__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .pga__drug { opacity: 0; animation: pga-bind var(--dur) infinite; }
  .pga__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .pga__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pga-pop var(--dur) infinite; }
  .pga__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .pga__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pga-pop-late var(--dur) infinite; }
  .pga__steps { counter-reset: pgastep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .pga__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: pga-step var(--dur) infinite; }
  .pga__step::before { counter-increment: pgastep; content: counter(pgastep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: pga-badge var(--dur) infinite; }
  .pga__step:nth-child(1), .pga__step:nth-child(1)::before { animation-delay: 0s; }
  .pga__step:nth-child(2), .pga__step:nth-child(2)::before { animation-delay: 3s; }
  .pga__step:nth-child(3), .pga__step:nth-child(3)::before { animation-delay: 6s; }
  .pga__step:nth-child(4), .pga__step:nth-child(4)::before { animation-delay: 9s; }
  .pga__step:nth-child(5), .pga__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes pga-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes pga-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes pga-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes pga-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes pga-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes pga-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes pga-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes pga-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .pga *, .pga__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .pga__step, .pga__step::before { animation: none !important; transform: none !important; }
    .pga__step { opacity: 1 !important; }
    .pga__drug { opacity: 1 !important; }
    .pga__shield { opacity: 1 !important; }
    .pga__resolved { opacity: 1 !important; }
    .pga__inflam { opacity: 0 !important; }
    .pga__dock-dot { opacity: 0 !important; }
  }
</style>
