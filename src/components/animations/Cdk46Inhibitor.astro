---
// Cdk46Inhibitor.astro — schematic, self-contained SVG + CSS animation of how a
// CDK4/6 inhibitor (e.g. 哌柏西利 / palbociclib) jams the CDK4/6 "motor" that
// drives a cancer cell through the G1->S division checkpoint, so the cell stops
// proliferating (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped
// CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s timeline
// (3s each). Under prefers-reduced-motion all motion stops and the diagram
// freezes on a coherent end-state (drug capping CDK4/6, checkpoint shut,
// division stopped).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 CDK4/6 抑制剂卡住癌细胞里的 CDK4/6 马达,使"分裂闸口"(G1→S)打不开,癌细胞停止增殖。',
  subject,
} = Astro.props;

const steps = [
  '癌细胞想不停分裂',
  'CDK4/6 马达推开"分裂闸口"(G1→S)',
  '这个药卡住 CDK4/6 马达',
  '"分裂闸口"打不开了',
  '癌细胞停在分裂前,不再增殖',
];
---

<div class="cdk">
  <svg class="cdk__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="cdk__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="cdk__t cdk__t--organ" x="36" y="196" text-anchor="start">癌细胞</text>
    <rect class="cdk__motor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="cdk__t cdk__t--small" x="208" y="126" text-anchor="middle">CDK4/6 马达</text>

    <g class="cdk__divide">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="cdk__t cdk__t--divide" x="208" y="66" text-anchor="middle">分裂闸口 G1→S · 不停分裂</text>
    </g>

    <g class="cdk__dots">
      <circle class="cdk__cyclin" cx="86" cy="52" r="10" />
      <text class="cdk__t cdk__t--small" x="86" y="34" text-anchor="middle">cyclin D</text>
    </g>

    <circle class="cdk__dock-dot" cx="208" cy="140" r="9" />

    <g class="cdk__drug">
      <rect class="cdk__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="cdk__t cdk__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'CDK4/6 抑制剂'}</text>
    </g>

    <g class="cdk__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="cdk__t cdk__t--shield" x="208" y="150" text-anchor="middle">闸口关闭</text>
    </g>

    <g class="cdk__resolved">
      <rect x="226" y="30" width="114" height="30" rx="15" />
      <text class="cdk__t cdk__t--resolved" x="283" y="50" text-anchor="middle">停止分裂</text>
    </g>
  </svg>

  <ol class="cdk__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="cdk__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .cdk {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .cdk__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .cdk__cell { fill: #fdf2f8; stroke: #f9a8d4; stroke-width: 2; }
  .cdk__motor { fill: #64748b; }
  .cdk__t { fill: #1e293b; font-size: 13px; }
  .cdk__t--organ { fill: #475569; font-size: 12px; }
  .cdk__t--small { font-size: 11px; fill: #475569; }
  .cdk__t--divide { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .cdk__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .cdk__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .cdk__t--resolved { fill: #15803d; font-size: 13px; font-weight: 700; }
  .cdk__cyclin { fill: #f472b6; stroke: #be185d; stroke-width: 1.5; }
  .cdk__dots { animation: cdk-drift var(--dur) infinite; }
  .cdk__divide polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .cdk__divide { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cdk-inflame var(--dur) infinite; }
  .cdk__dock-dot { fill: #f472b6; stroke: #be185d; stroke-width: 1.5; opacity: 0; animation: cdk-dock var(--dur) infinite; }
  .cdk__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .cdk__drug { opacity: 0; animation: cdk-bind var(--dur) infinite; }
  .cdk__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .cdk__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cdk-pop var(--dur) infinite; }
  .cdk__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .cdk__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cdk-pop-late var(--dur) infinite; }
  .cdk__steps { counter-reset: cdkstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .cdk__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: cdk-step var(--dur) infinite; }
  .cdk__step::before { counter-increment: cdkstep; content: counter(cdkstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: cdk-badge var(--dur) infinite; }
  .cdk__step:nth-child(1), .cdk__step:nth-child(1)::before { animation-delay: 0s; }
  .cdk__step:nth-child(2), .cdk__step:nth-child(2)::before { animation-delay: 3s; }
  .cdk__step:nth-child(3), .cdk__step:nth-child(3)::before { animation-delay: 6s; }
  .cdk__step:nth-child(4), .cdk__step:nth-child(4)::before { animation-delay: 9s; }
  .cdk__step:nth-child(5), .cdk__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes cdk-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes cdk-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes cdk-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes cdk-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes cdk-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes cdk-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes cdk-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes cdk-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .cdk *, .cdk__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .cdk__step, .cdk__step::before { animation: none !important; transform: none !important; }
    .cdk__step { opacity: 1 !important; }
    .cdk__drug { opacity: 1 !important; }
    .cdk__shield { opacity: 1 !important; }
    .cdk__resolved { opacity: 1 !important; }
    .cdk__divide { opacity: 0 !important; }
    .cdk__dock-dot { opacity: 0 !important; }
  }
</style>
