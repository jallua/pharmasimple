---
// AntiFgf23.astro — schematic, self-contained SVG + CSS animation of how an
// anti-FGF23 antibody (e.g. 布罗索尤单抗 / burosumab) neutralises the excess
// phosphate-wasting hormone FGF23, so the kidney holds on to phosphate again and
// bones can mineralise normally (需求 4, 13). SCHEMATIC labelled shapes, inline
// SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗 FGF23 抗体中和过多的 FGF23,肾脏重新保留磷、血磷回升,骨骼逐渐矿化。',
  subject,
} = Astro.props;

const steps = [
  'FGF23 过多,命令肾脏"把磷排掉"',
  '血磷过低,骨头矿化不足(佝偻病/骨软化)',
  '抗 FGF23 抗体中和多余的 FGF23',
  '肾脏重新保留磷、血磷回升',
  '骨骼获得足够磷、逐渐矿化变强',
];
---

<div class="fgf">
  <svg class="fgf__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="fgf__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="fgf__t fgf__t--organ" x="36" y="196" text-anchor="start">肾小管</text>
    <rect class="fgf__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="fgf__t fgf__t--small" x="208" y="126" text-anchor="middle">磷重吸收(受 FGF23 抑制)</text>

    <g class="fgf__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="fgf__t fgf__t--inflam" x="208" y="66" text-anchor="middle">磷流失 · 骨软化</text>
    </g>

    <g class="fgf__dots">
      <circle class="fgf__lig" cx="70" cy="52" r="10" />
      <circle class="fgf__lig" cx="118" cy="36" r="10" />
      <circle class="fgf__lig" cx="96" cy="82" r="10" />
      <text class="fgf__t fgf__t--small" x="96" y="16" text-anchor="middle">FGF23(过多)</text>
    </g>

    <circle class="fgf__dock-dot" cx="208" cy="140" r="9" />

    <g class="fgf__drug">
      <path class="fgf__ab" d="M208 214 L208 166 M208 166 L192 142 M208 166 L224 142" />
      <text class="fgf__t fgf__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗 FGF23 抗体'}</text>
    </g>

    <g class="fgf__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="fgf__t fgf__t--shield" x="208" y="150" text-anchor="middle">FGF23 被中和</text>
    </g>

    <g class="fgf__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="fgf__t fgf__t--resolved" x="275" y="50" text-anchor="middle">磷被保留 · 骨骼矿化</text>
    </g>
  </svg>

  <ol class="fgf__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="fgf__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .fgf {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .fgf__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .fgf__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .fgf__receptor { fill: #64748b; }
  .fgf__t { fill: #1e293b; font-size: 13px; }
  .fgf__t--organ { fill: #475569; font-size: 12px; }
  .fgf__t--small { font-size: 11px; fill: #475569; }
  .fgf__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .fgf__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .fgf__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .fgf__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .fgf__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .fgf__dots { animation: fgf-drift var(--dur) infinite; }
  .fgf__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .fgf__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: fgf-inflame var(--dur) infinite; }
  .fgf__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: fgf-dock var(--dur) infinite; }
  .fgf__ab { fill: none; stroke: #0f766e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .fgf__drug { opacity: 0; animation: fgf-bind var(--dur) infinite; }
  .fgf__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .fgf__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: fgf-pop var(--dur) infinite; }
  .fgf__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .fgf__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: fgf-pop-late var(--dur) infinite; }
  .fgf__steps { counter-reset: fgfstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .fgf__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: fgf-step var(--dur) infinite; }
  .fgf__step::before { counter-increment: fgfstep; content: counter(fgfstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: fgf-badge var(--dur) infinite; }
  .fgf__step:nth-child(1), .fgf__step:nth-child(1)::before { animation-delay: 0s; }
  .fgf__step:nth-child(2), .fgf__step:nth-child(2)::before { animation-delay: 3s; }
  .fgf__step:nth-child(3), .fgf__step:nth-child(3)::before { animation-delay: 6s; }
  .fgf__step:nth-child(4), .fgf__step:nth-child(4)::before { animation-delay: 9s; }
  .fgf__step:nth-child(5), .fgf__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes fgf-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes fgf-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes fgf-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes fgf-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes fgf-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes fgf-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes fgf-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes fgf-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .fgf *, .fgf__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .fgf__step, .fgf__step::before { animation: none !important; transform: none !important; }
    .fgf__step { opacity: 1 !important; }
    .fgf__drug { opacity: 1 !important; }
    .fgf__shield { opacity: 1 !important; }
    .fgf__resolved { opacity: 1 !important; }
    .fgf__inflam { opacity: 0 !important; }
    .fgf__dock-dot { opacity: 0 !important; }
  }
</style>
