---
// AlkInhibitor.astro — schematic, self-contained SVG + CSS animation of how an
// ALK tyrosine-kinase inhibitor (e.g. 伊鲁阿克 / iruplinalkib) switches off the
// "always-on" ALK fusion kinase that drives ALK-positive lung cancer, cutting
// the "divide" signal so the cell stops proliferating (需求 4, 13). SCHEMATIC
// labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps
// cycle on a shared 15s timeline (3s each). Under prefers-reduced-motion all
// motion stops and the diagram freezes on a coherent end-state.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 ALK 抑制剂关掉肺癌细胞里"永远开机"的 ALK 激酶,切断快分裂信号,使癌细胞停止增殖。',
  subject,
} = Astro.props;

const steps = [
  'ALK 基因错接,拼出"永远开机"的 ALK 激酶',
  'ALK 激酶不停发出"快分裂"信号',
  '这个药卡住 ALK 激酶',
  '"快分裂"信号被切断',
  '癌细胞停止增殖',
];
---

<div class="alk">
  <svg class="alk__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="alk__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="alk__t alk__t--organ" x="36" y="196" text-anchor="start">肺癌细胞</text>
    <rect class="alk__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="alk__t alk__t--small" x="208" y="126" text-anchor="middle">ALK 激酶</text>

    <g class="alk__grow">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="alk__t alk__t--grow" x="208" y="66" text-anchor="middle">催癌细胞不停分裂</text>
    </g>

    <g class="alk__dots">
      <circle class="alk__sig" cx="70" cy="52" r="10" />
      <circle class="alk__sig" cx="118" cy="36" r="10" />
      <circle class="alk__sig" cx="96" cy="82" r="10" />
      <text class="alk__t alk__t--small" x="96" y="16" text-anchor="middle">促增殖信号</text>
    </g>

    <circle class="alk__dock-dot" cx="208" cy="140" r="9" />

    <g class="alk__drug">
      <rect class="alk__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="alk__t alk__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'ALK 抑制剂'}</text>
    </g>

    <g class="alk__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="alk__t alk__t--shield" x="208" y="150" text-anchor="middle">激酶关闭</text>
    </g>

    <g class="alk__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="alk__t alk__t--resolved" x="283" y="50" text-anchor="middle">癌细胞停止增殖</text>
    </g>
  </svg>

  <ol class="alk__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="alk__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .alk {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .alk__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .alk__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .alk__receptor { fill: #64748b; }
  .alk__t { fill: #1e293b; font-size: 13px; }
  .alk__t--organ { fill: #475569; font-size: 12px; }
  .alk__t--small { font-size: 11px; fill: #475569; }
  .alk__t--grow { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .alk__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .alk__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .alk__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .alk__sig { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; }
  .alk__dots { animation: alk-drift var(--dur) infinite; }
  .alk__grow polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .alk__grow { opacity: 0; transform-box: fill-box; transform-origin: center; animation: alk-inflame var(--dur) infinite; }
  .alk__dock-dot { fill: #f59e0b; stroke: #b45309; stroke-width: 1.5; opacity: 0; animation: alk-dock var(--dur) infinite; }
  .alk__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .alk__drug { opacity: 0; animation: alk-bind var(--dur) infinite; }
  .alk__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .alk__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: alk-pop var(--dur) infinite; }
  .alk__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .alk__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: alk-pop-late var(--dur) infinite; }
  .alk__steps { counter-reset: alkstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .alk__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: alk-step var(--dur) infinite; }
  .alk__step::before { counter-increment: alkstep; content: counter(alkstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: alk-badge var(--dur) infinite; }
  .alk__step:nth-child(1), .alk__step:nth-child(1)::before { animation-delay: 0s; }
  .alk__step:nth-child(2), .alk__step:nth-child(2)::before { animation-delay: 3s; }
  .alk__step:nth-child(3), .alk__step:nth-child(3)::before { animation-delay: 6s; }
  .alk__step:nth-child(4), .alk__step:nth-child(4)::before { animation-delay: 9s; }
  .alk__step:nth-child(5), .alk__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes alk-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes alk-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes alk-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes alk-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes alk-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes alk-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes alk-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes alk-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .alk *, .alk__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .alk__step, .alk__step::before { animation: none !important; transform: none !important; }
    .alk__step { opacity: 1 !important; }
    .alk__drug { opacity: 1 !important; }
    .alk__shield { opacity: 1 !important; }
    .alk__resolved { opacity: 1 !important; }
    .alk__grow { opacity: 0 !important; }
    .alk__dock-dot { opacity: 0 !important; }
  }
</style>
