---
// SodiumChannelBlocker.astro — schematic, self-contained SVG + CSS animation of
// how a sodium-channel-modulating antiseizure drug (e.g. 塞诺巴美 / cenobamate)
// stabilises overactive voltage-gated sodium channels and damps the abnormal
// "persistent sodium current", so runaway neuronal firing settles and seizures
// become less frequent (需求 4, 13). SCHEMATIC labelled shapes, inline SVG +
// scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示抗癫痫药稳住神经元上过度开放的钠通道、压制异常的持续钠电流,使异常放电平息、癫痫发作减少。',
  subject,
} = Astro.props;

const steps = [
  '神经元靠钠通道一开一关传递电信号',
  '钠通道“关不紧”(持续钠电流),神经元异常放电',
  '抗癫痫药稳住钠通道、压制持续钠电流',
  '异常放电被压下来(并增强 GABA 抑制)',
  '癫痫发作随之减少',
];
---

<div class="scb">
  <svg class="scb__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="scb__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="scb__t scb__t--organ" x="36" y="196" text-anchor="start">神经元</text>
    <rect class="scb__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="scb__t scb__t--small" x="208" y="126" text-anchor="middle">钠通道(Nav)</text>

    <g class="scb__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="scb__t scb__t--harm" x="208" y="66" text-anchor="middle">异常放电 · 癫痫</text>
    </g>

    <g class="scb__dots">
      <circle class="scb__ion" cx="70" cy="52" r="10" />
      <circle class="scb__ion" cx="118" cy="36" r="10" />
      <circle class="scb__ion" cx="96" cy="82" r="10" />
      <text class="scb__t scb__t--small" x="96" y="16" text-anchor="middle">钠离子流</text>
    </g>

    <circle class="scb__dock-dot" cx="208" cy="140" r="9" />

    <g class="scb__drug">
      <rect class="scb__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="scb__t scb__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '抗癫痫药'}</text>
    </g>

    <g class="scb__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="scb__t scb__t--shield" x="208" y="150" text-anchor="middle">稳住</text>
    </g>

    <g class="scb__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="scb__t scb__t--resolved" x="279" y="50" text-anchor="middle">发作减少</text>
    </g>
  </svg>

  <ol class="scb__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="scb__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .scb {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .scb__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .scb__cell { fill: #eef2ff; stroke: #a5b4fc; stroke-width: 2; }
  .scb__receptor { fill: #64748b; }
  .scb__t { fill: #1e293b; font-size: 13px; }
  .scb__t--organ { fill: #475569; font-size: 12px; }
  .scb__t--small { font-size: 11px; fill: #475569; }
  .scb__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .scb__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .scb__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .scb__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .scb__ion { fill: #38bdf8; stroke: #0369a1; stroke-width: 1.5; }
  .scb__dots { animation: scb-drift var(--dur) infinite; }
  .scb__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .scb__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: scb-inflame var(--dur) infinite; }
  .scb__dock-dot { fill: #38bdf8; stroke: #0369a1; stroke-width: 1.5; opacity: 0; animation: scb-dock var(--dur) infinite; }
  .scb__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .scb__drug { opacity: 0; animation: scb-bind var(--dur) infinite; }
  .scb__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .scb__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: scb-pop var(--dur) infinite; }
  .scb__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .scb__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: scb-pop-late var(--dur) infinite; }
  .scb__steps { counter-reset: scbstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .scb__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: scb-step var(--dur) infinite; }
  .scb__step::before { counter-increment: scbstep; content: counter(scbstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: scb-badge var(--dur) infinite; }
  .scb__step:nth-child(1), .scb__step:nth-child(1)::before { animation-delay: 0s; }
  .scb__step:nth-child(2), .scb__step:nth-child(2)::before { animation-delay: 3s; }
  .scb__step:nth-child(3), .scb__step:nth-child(3)::before { animation-delay: 6s; }
  .scb__step:nth-child(4), .scb__step:nth-child(4)::before { animation-delay: 9s; }
  .scb__step:nth-child(5), .scb__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes scb-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes scb-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes scb-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes scb-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes scb-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes scb-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes scb-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes scb-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .scb *, .scb__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .scb__step, .scb__step::before { animation: none !important; transform: none !important; }
    .scb__step { opacity: 1 !important; }
    .scb__drug { opacity: 1 !important; }
    .scb__shield { opacity: 1 !important; }
    .scb__resolved { opacity: 1 !important; }
    .scb__harm { opacity: 0 !important; }
    .scb__dock-dot { opacity: 0 !important; }
  }
</style>