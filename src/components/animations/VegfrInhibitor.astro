---
// VegfrInhibitor.astro — schematic, self-contained SVG + CSS animation of how a
// VEGFR (multikinase) inhibitor (e.g. 仑伐替尼 / lenvatinib) blocks the VEGFR on
// a blood-vessel cell so tumors can no longer grow the new blood vessels that
// feed them (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO
// JavaScript. Five storyboard steps cycle on a shared 15s timeline (3s each).
// Under prefers-reduced-motion all motion stops and the diagram freezes on a
// coherent end-state (drug capping VEGFR, no new vessels, tumor supply cut).
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 VEGFR 抑制剂卡住血管细胞的 VEGFR,阻止长出新血管,断掉肿瘤的"补给线"。',
  subject,
} = Astro.props;

const steps = [
  '肿瘤想长大,需要新血管来"供血供养"',
  'VEGF 信号接上血管细胞的 VEGFR,催长新血管',
  '这个药卡住 VEGFR(还有 FGFR 等)',
  '新血管长不出来',
  '肿瘤断了"补给线",生长受抑',
];
---

<div class="vegf">
  <svg class="vegf__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="vegf__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="vegf__t vegf__t--organ" x="36" y="196" text-anchor="start">血管内皮细胞</text>
    <rect class="vegf__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="vegf__t vegf__t--small" x="208" y="126" text-anchor="middle">VEGFR 受体</text>

    <g class="vegf__grow">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="vegf__t vegf__t--grow" x="208" y="66" text-anchor="middle">长新血管喂养肿瘤</text>
    </g>

    <g class="vegf__dots">
      <circle class="vegf__vegf" cx="70" cy="52" r="10" />
      <circle class="vegf__vegf" cx="118" cy="36" r="10" />
      <circle class="vegf__vegf" cx="96" cy="82" r="10" />
      <text class="vegf__t vegf__t--small" x="96" y="16" text-anchor="middle">VEGF 生长信号</text>
    </g>

    <circle class="vegf__dock-dot" cx="208" cy="140" r="9" />

    <g class="vegf__drug">
      <rect class="vegf__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="vegf__t vegf__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'VEGFR 抑制剂'}</text>
    </g>

    <g class="vegf__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="vegf__t vegf__t--shield" x="208" y="150" text-anchor="middle">卡住</text>
    </g>

    <g class="vegf__resolved">
      <rect x="222" y="30" width="122" height="30" rx="15" />
      <text class="vegf__t vegf__t--resolved" x="283" y="50" text-anchor="middle">断了补给线</text>
    </g>
  </svg>

  <ol class="vegf__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="vegf__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .vegf {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .vegf__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .vegf__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .vegf__receptor { fill: #64748b; }
  .vegf__t { fill: #1e293b; font-size: 13px; }
  .vegf__t--organ { fill: #475569; font-size: 12px; }
  .vegf__t--small { font-size: 11px; fill: #475569; }
  .vegf__t--grow { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .vegf__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .vegf__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .vegf__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .vegf__vegf { fill: #fb923c; stroke: #ea580c; stroke-width: 1.5; }
  .vegf__dots { animation: vegf-drift var(--dur) infinite; }
  .vegf__grow polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .vegf__grow { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vegf-inflame var(--dur) infinite; }
  .vegf__dock-dot { fill: #fb923c; stroke: #ea580c; stroke-width: 1.5; opacity: 0; animation: vegf-dock var(--dur) infinite; }
  .vegf__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .vegf__drug { opacity: 0; animation: vegf-bind var(--dur) infinite; }
  .vegf__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .vegf__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vegf-pop var(--dur) infinite; }
  .vegf__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .vegf__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vegf-pop-late var(--dur) infinite; }
  .vegf__steps { counter-reset: vegfstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .vegf__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: vegf-step var(--dur) infinite; }
  .vegf__step::before { counter-increment: vegfstep; content: counter(vegfstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: vegf-badge var(--dur) infinite; }
  .vegf__step:nth-child(1), .vegf__step:nth-child(1)::before { animation-delay: 0s; }
  .vegf__step:nth-child(2), .vegf__step:nth-child(2)::before { animation-delay: 3s; }
  .vegf__step:nth-child(3), .vegf__step:nth-child(3)::before { animation-delay: 6s; }
  .vegf__step:nth-child(4), .vegf__step:nth-child(4)::before { animation-delay: 9s; }
  .vegf__step:nth-child(5), .vegf__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes vegf-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes vegf-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes vegf-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes vegf-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes vegf-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes vegf-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes vegf-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes vegf-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .vegf *, .vegf__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .vegf__step, .vegf__step::before { animation: none !important; transform: none !important; }
    .vegf__step { opacity: 1 !important; }
    .vegf__drug { opacity: 1 !important; }
    .vegf__shield { opacity: 1 !important; }
    .vegf__resolved { opacity: 1 !important; }
    .vegf__grow { opacity: 0 !important; }
    .vegf__dock-dot { opacity: 0 !important; }
  }
</style>
