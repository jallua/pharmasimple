---
// TnfDecoyReceptor.astro — schematic SVG + CSS animation of how a soluble TNF
// decoy-receptor fusion protein (e.g. 依那西普 / etanercept, p75/TNFR2–Fc) floats
// in the blood and sponges up excess TNF-α (and lymphotoxin-α) before they reach
// the cell's real TNF receptor, so inflammation subsides. Unlike an antibody it
// binds soluble TNF best and forms less stable complexes with membrane TNF
// (需求 4, 13). SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO JavaScript.
// Five storyboard steps cycle on a shared 15s timeline (3s each). Under
// prefers-reduced-motion all motion stops.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示依那西普作为可溶性“诱饵受体”在血里抢先粘住 TNF 与淋巴毒素 α,使它们到不了细胞受体,炎症减轻。',
  subject,
} = Astro.props;

const steps = [
  '自身免疫病里,TNF(还有淋巴毒素 α)过多',
  '它们本该接到细胞的 TNF 受体、点燃炎症',
  '依那西普是血里游动的“可溶性诱饵受体”',
  '抢先把 TNF / LT-α 粘住,让它们到不了细胞',
  '炎症信号被中和,红肿损伤减轻',
];
---

<div class="tdr">
  <svg class="tdr__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="tdr__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="tdr__t tdr__t--organ" x="36" y="196" text-anchor="start">免疫 / 关节细胞</text>
    <rect class="tdr__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="tdr__t tdr__t--small" x="208" y="126" text-anchor="middle">TNF 受体</text>

    <g class="tdr__harm">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="tdr__t tdr__t--harm" x="208" y="66" text-anchor="middle">炎症 · 红肿损伤</text>
    </g>

    <g class="tdr__dots">
      <circle class="tdr__lig" cx="70" cy="52" r="10" />
      <circle class="tdr__lig" cx="118" cy="36" r="10" />
      <circle class="tdr__lig" cx="96" cy="82" r="10" />
      <text class="tdr__t tdr__t--small" x="96" y="16" text-anchor="middle">TNF / LT-α</text>
    </g>

    <circle class="tdr__dock-dot" cx="208" cy="140" r="9" />

    <g class="tdr__drug">
      <path class="tdr__decoy" d="M190 138 L190 148 Q208 160 226 148 L226 138" />
      <line class="tdr__stem" x1="208" y1="152" x2="208" y2="168" />
      <text class="tdr__t tdr__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '可溶性诱饵受体'}</text>
    </g>

    <g class="tdr__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="tdr__t tdr__t--shield" x="208" y="150" text-anchor="middle">诱饵粘住</text>
    </g>

    <g class="tdr__resolved">
      <rect x="214" y="30" width="130" height="30" rx="15" />
      <text class="tdr__t tdr__t--resolved" x="279" y="50" text-anchor="middle">炎症减轻</text>
    </g>
  </svg>

  <ol class="tdr__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="tdr__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .tdr {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .tdr__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .tdr__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .tdr__receptor { fill: #64748b; }
  .tdr__t { fill: #1e293b; font-size: 13px; }
  .tdr__t--organ { fill: #475569; font-size: 12px; }
  .tdr__t--small { font-size: 11px; fill: #475569; }
  .tdr__t--harm { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .tdr__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .tdr__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .tdr__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .tdr__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .tdr__dots { animation: tdr-drift var(--dur) infinite; }
  .tdr__harm polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .tdr__harm { opacity: 0; transform-box: fill-box; transform-origin: center; animation: tdr-inflame var(--dur) infinite; }
  .tdr__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: tdr-dock var(--dur) infinite; }
  .tdr__decoy { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .tdr__stem { stroke: #0f766e; stroke-width: 3; stroke-linecap: round; }
  .tdr__drug { opacity: 0; animation: tdr-bind var(--dur) infinite; }
  .tdr__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .tdr__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: tdr-pop var(--dur) infinite; }
  .tdr__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .tdr__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: tdr-pop-late var(--dur) infinite; }
  .tdr__steps { counter-reset: tdrstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .tdr__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: tdr-step var(--dur) infinite; }
  .tdr__step::before { counter-increment: tdrstep; content: counter(tdrstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: tdr-badge var(--dur) infinite; }
  .tdr__step:nth-child(1), .tdr__step:nth-child(1)::before { animation-delay: 0s; }
  .tdr__step:nth-child(2), .tdr__step:nth-child(2)::before { animation-delay: 3s; }
  .tdr__step:nth-child(3), .tdr__step:nth-child(3)::before { animation-delay: 6s; }
  .tdr__step:nth-child(4), .tdr__step:nth-child(4)::before { animation-delay: 9s; }
  .tdr__step:nth-child(5), .tdr__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes tdr-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes tdr-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes tdr-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes tdr-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes tdr-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes tdr-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes tdr-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes tdr-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .tdr *, .tdr__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .tdr__step, .tdr__step::before { animation: none !important; transform: none !important; }
    .tdr__step { opacity: 1 !important; }
    .tdr__drug { opacity: 1 !important; }
    .tdr__shield { opacity: 1 !important; }
    .tdr__resolved { opacity: 1 !important; }
    .tdr__harm { opacity: 0 !important; }
    .tdr__dock-dot { opacity: 0 !important; }
  }
</style>
