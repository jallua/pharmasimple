---
// ParpInhibitor.astro — schematic, self-contained SVG + CSS animation of how a
// PARP inhibitor (e.g. 尼拉帕利 / niraparib) pins the cancer cell's DNA-repair
// enzyme PARP onto the DNA so single-strand breaks can no longer be patched;
// unrepaired breaks pile up until the cancer cell dies (需求 4, 13). SCHEMATIC
// labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five storyboard steps
// cycle on a shared 15s timeline (3s each). Under prefers-reduced-motion all
// motion stops and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示 PARP 抑制剂摁住癌细胞的 DNA 修复酶,DNA 断裂无法修复、不断累积,最终癌细胞死亡。',
  subject,
} = Astro.props;

const steps = [
  '癌细胞的 DNA 常出现单链断裂',
  'PARP 像"补丁工",随时修复断裂',
  '这个药摁住 PARP、把它钉在 DNA 上',
  '断裂修不好,不断累积',
  'DNA 损伤压垮癌细胞,癌细胞死亡',
];
---

<div class="parp">
  <svg class="parp__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="parp__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="parp__t parp__t--organ" x="36" y="196" text-anchor="start">癌细胞</text>
    <rect class="parp__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="parp__t parp__t--small" x="208" y="126" text-anchor="middle">PARP 修复酶</text>

    <g class="parp__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="parp__t parp__t--inflam" x="208" y="66" text-anchor="middle">DNA 断裂累积</text>
    </g>

    <g class="parp__dots">
      <circle class="parp__lig" cx="70" cy="52" r="10" />
      <circle class="parp__lig" cx="118" cy="36" r="10" />
      <circle class="parp__lig" cx="96" cy="82" r="10" />
      <text class="parp__t parp__t--small" x="96" y="16" text-anchor="middle">DNA 断裂</text>
    </g>

    <circle class="parp__dock-dot" cx="208" cy="140" r="9" />

    <g class="parp__drug">
      <rect class="parp__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="parp__t parp__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'PARP 抑制剂'}</text>
    </g>

    <g class="parp__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="parp__t parp__t--shield" x="208" y="150" text-anchor="middle">PARP 被抑制</text>
    </g>

    <g class="parp__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="parp__t parp__t--resolved" x="275" y="50" text-anchor="middle">损伤修不好 · 癌细胞死亡</text>
    </g>
  </svg>

  <ol class="parp__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="parp__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .parp {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .parp__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .parp__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .parp__receptor { fill: #64748b; }
  .parp__t { fill: #1e293b; font-size: 13px; }
  .parp__t--organ { fill: #475569; font-size: 12px; }
  .parp__t--small { font-size: 11px; fill: #475569; }
  .parp__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .parp__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .parp__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .parp__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .parp__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .parp__dots { animation: parp-drift var(--dur) infinite; }
  .parp__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .parp__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: parp-inflame var(--dur) infinite; }
  .parp__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: parp-dock var(--dur) infinite; }
  .parp__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .parp__drug { opacity: 0; animation: parp-bind var(--dur) infinite; }
  .parp__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .parp__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: parp-pop var(--dur) infinite; }
  .parp__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .parp__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: parp-pop-late var(--dur) infinite; }
  .parp__steps { counter-reset: parpstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .parp__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: parp-step var(--dur) infinite; }
  .parp__step::before { counter-increment: parpstep; content: counter(parpstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: parp-badge var(--dur) infinite; }
  .parp__step:nth-child(1), .parp__step:nth-child(1)::before { animation-delay: 0s; }
  .parp__step:nth-child(2), .parp__step:nth-child(2)::before { animation-delay: 3s; }
  .parp__step:nth-child(3), .parp__step:nth-child(3)::before { animation-delay: 6s; }
  .parp__step:nth-child(4), .parp__step:nth-child(4)::before { animation-delay: 9s; }
  .parp__step:nth-child(5), .parp__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes parp-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes parp-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes parp-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes parp-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes parp-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes parp-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes parp-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes parp-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .parp *, .parp__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .parp__step, .parp__step::before { animation: none !important; transform: none !important; }
    .parp__step { opacity: 1 !important; }
    .parp__drug { opacity: 1 !important; }
    .parp__shield { opacity: 1 !important; }
    .parp__resolved { opacity: 1 !important; }
    .parp__inflam { opacity: 0 !important; }
    .parp__dock-dot { opacity: 0 !important; }
  }
</style>
