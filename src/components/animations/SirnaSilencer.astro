---
// SirnaSilencer.astro — schematic, self-contained SVG + CSS animation of how an
// RNA interference (RNAi) small interfering RNA (e.g. 伏西兰 / vutrisiran) silences
// the TTR messenger RNA in the liver: the siRNA finds the TTR mRNA "blueprint"
// and shreds it, so the cell stops making TTR protein and the amyloid buildup in
// nerves and heart slowly eases (需求 4, 13). SCHEMATIC labelled shapes, inline
// SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared 15s
// timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示小干扰 RNA 找到 TTR 的信使 RNA 并将其降解,TTR 蛋白停止生产,淀粉样沉积逐渐减轻。',
  subject,
} = Astro.props;

const steps = [
  '肝脏按 TTR 图纸(mRNA)不停造 TTR 蛋白',
  '异常 TTR 堆积,伤害神经和心脏',
  '这段 siRNA 找到 TTR 的信使 RNA',
  '图纸被绞碎,TTR 停止生产',
  'TTR 越来越少,沉积逐渐减轻',
];
---

<div class="sirna">
  <svg class="sirna__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="sirna__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="sirna__t sirna__t--organ" x="36" y="196" text-anchor="start">肝细胞</text>
    <rect class="sirna__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="sirna__t sirna__t--small" x="208" y="126" text-anchor="middle">TTR 信使 RNA(图纸)</text>

    <g class="sirna__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="sirna__t sirna__t--inflam" x="208" y="66" text-anchor="middle">异常 TTR 堆积</text>
    </g>

    <g class="sirna__dots">
      <circle class="sirna__lig" cx="70" cy="52" r="10" />
      <circle class="sirna__lig" cx="118" cy="36" r="10" />
      <circle class="sirna__lig" cx="96" cy="82" r="10" />
      <text class="sirna__t sirna__t--small" x="96" y="16" text-anchor="middle">TTR 蛋白</text>
    </g>

    <circle class="sirna__dock-dot" cx="208" cy="140" r="9" />

    <g class="sirna__drug">
      <rect class="sirna__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="sirna__t sirna__t--drug" x="208" y="232" text-anchor="middle">{subject ?? 'TTR siRNA'}</text>
    </g>

    <g class="sirna__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="sirna__t sirna__t--shield" x="208" y="150" text-anchor="middle">mRNA 被降解</text>
    </g>

    <g class="sirna__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="sirna__t sirna__t--resolved" x="275" y="50" text-anchor="middle">TTR 减少 · 沉积减轻</text>
    </g>
  </svg>

  <ol class="sirna__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="sirna__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .sirna {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .sirna__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .sirna__cell { fill: #faf5ff; stroke: #d8b4fe; stroke-width: 2; }
  .sirna__receptor { fill: #64748b; }
  .sirna__t { fill: #1e293b; font-size: 13px; }
  .sirna__t--organ { fill: #475569; font-size: 12px; }
  .sirna__t--small { font-size: 11px; fill: #475569; }
  .sirna__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .sirna__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .sirna__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .sirna__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .sirna__lig { fill: #c084fc; stroke: #7e22ce; stroke-width: 1.5; }
  .sirna__dots { animation: sirna-drift var(--dur) infinite; }
  .sirna__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .sirna__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: sirna-inflame var(--dur) infinite; }
  .sirna__dock-dot { fill: #c084fc; stroke: #7e22ce; stroke-width: 1.5; opacity: 0; animation: sirna-dock var(--dur) infinite; }
  .sirna__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .sirna__drug { opacity: 0; animation: sirna-bind var(--dur) infinite; }
  .sirna__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .sirna__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: sirna-pop var(--dur) infinite; }
  .sirna__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .sirna__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: sirna-pop-late var(--dur) infinite; }
  .sirna__steps { counter-reset: sirnastep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .sirna__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: sirna-step var(--dur) infinite; }
  .sirna__step::before { counter-increment: sirnastep; content: counter(sirnastep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: sirna-badge var(--dur) infinite; }
  .sirna__step:nth-child(1), .sirna__step:nth-child(1)::before { animation-delay: 0s; }
  .sirna__step:nth-child(2), .sirna__step:nth-child(2)::before { animation-delay: 3s; }
  .sirna__step:nth-child(3), .sirna__step:nth-child(3)::before { animation-delay: 6s; }
  .sirna__step:nth-child(4), .sirna__step:nth-child(4)::before { animation-delay: 9s; }
  .sirna__step:nth-child(5), .sirna__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes sirna-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes sirna-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes sirna-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes sirna-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes sirna-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes sirna-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes sirna-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes sirna-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .sirna *, .sirna__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .sirna__step, .sirna__step::before { animation: none !important; transform: none !important; }
    .sirna__step { opacity: 1 !important; }
    .sirna__drug { opacity: 1 !important; }
    .sirna__shield { opacity: 1 !important; }
    .sirna__resolved { opacity: 1 !important; }
    .sirna__inflam { opacity: 0 !important; }
    .sirna__dock-dot { opacity: 0 !important; }
  }
</style>
