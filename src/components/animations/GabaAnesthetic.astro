---
// GabaAnesthetic.astro — schematic, self-contained SVG + CSS animation of how an
// intravenous general anaesthetic (e.g. 丙泊酚 / propofol) potentiates the brain's
// GABA-A receptor, so chloride pours in, the neuron is strongly inhibited and the
// patient rapidly loses consciousness under general anaesthesia (需求 4, 13).
// SCHEMATIC labelled shapes, inline SVG + scoped CSS, NO JavaScript. Five
// storyboard steps cycle on a shared 15s timeline (3s each). Under
// prefers-reduced-motion all motion stops and the diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示丙泊酚增强脑内 GABA-A 受体,氯离子涌入使神经元被强烈抑制,迅速进入全身麻醉。',
  subject,
} = Astro.props;

const steps = [
  '大脑神经元不停放电,维持清醒',
  'GABA 是"刹车"信号,让神经安静',
  '丙泊酚增强 GABA-A 受体的作用',
  '氯离子涌入,神经元被强烈抑制',
  '意识迅速消失,进入全身麻醉',
];
---

<div class="gaba">
  <svg class="gaba__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="gaba__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="gaba__t gaba__t--organ" x="36" y="196" text-anchor="start">脑神经元</text>
    <rect class="gaba__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="gaba__t gaba__t--small" x="208" y="126" text-anchor="middle">GABA-A 受体</text>

    <g class="gaba__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="gaba__t gaba__t--inflam" x="208" y="66" text-anchor="middle">神经元活跃 · 清醒</text>
    </g>

    <g class="gaba__dots">
      <circle class="gaba__lig" cx="70" cy="52" r="10" />
      <circle class="gaba__lig" cx="118" cy="36" r="10" />
      <circle class="gaba__lig" cx="96" cy="82" r="10" />
      <text class="gaba__t gaba__t--small" x="96" y="16" text-anchor="middle">氯离子</text>
    </g>

    <circle class="gaba__dock-dot" cx="208" cy="140" r="9" />

    <g class="gaba__drug">
      <rect class="gaba__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="gaba__t gaba__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '丙泊酚(全身麻醉)'}</text>
    </g>

    <g class="gaba__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="gaba__t gaba__t--shield" x="208" y="150" text-anchor="middle">GABA 闸门开大</text>
    </g>

    <g class="gaba__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="gaba__t gaba__t--resolved" x="275" y="50" text-anchor="middle">神经被抑制 · 进入麻醉</text>
    </g>
  </svg>

  <ol class="gaba__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="gaba__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .gaba {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .gaba__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .gaba__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .gaba__receptor { fill: #64748b; }
  .gaba__t { fill: #1e293b; font-size: 13px; }
  .gaba__t--organ { fill: #475569; font-size: 12px; }
  .gaba__t--small { font-size: 11px; fill: #475569; }
  .gaba__t--inflam { fill: #b91c1c; font-size: 11px; font-weight: 700; }
  .gaba__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .gaba__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .gaba__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .gaba__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .gaba__dots { animation: gaba-drift var(--dur) infinite; }
  .gaba__inflam polygon { fill: #fca5a5; stroke: #ef4444; stroke-width: 1.5; }
  .gaba__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gaba-inflame var(--dur) infinite; }
  .gaba__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: gaba-dock var(--dur) infinite; }
  .gaba__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .gaba__drug { opacity: 0; animation: gaba-bind var(--dur) infinite; }
  .gaba__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .gaba__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gaba-pop var(--dur) infinite; }
  .gaba__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .gaba__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: gaba-pop-late var(--dur) infinite; }
  .gaba__steps { counter-reset: gabastep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .gaba__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: gaba-step var(--dur) infinite; }
  .gaba__step::before { counter-increment: gabastep; content: counter(gabastep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: gaba-badge var(--dur) infinite; }
  .gaba__step:nth-child(1), .gaba__step:nth-child(1)::before { animation-delay: 0s; }
  .gaba__step:nth-child(2), .gaba__step:nth-child(2)::before { animation-delay: 3s; }
  .gaba__step:nth-child(3), .gaba__step:nth-child(3)::before { animation-delay: 6s; }
  .gaba__step:nth-child(4), .gaba__step:nth-child(4)::before { animation-delay: 9s; }
  .gaba__step:nth-child(5), .gaba__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes gaba-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes gaba-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes gaba-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes gaba-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes gaba-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes gaba-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes gaba-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes gaba-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .gaba *, .gaba__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .gaba__step, .gaba__step::before { animation: none !important; transform: none !important; }
    .gaba__step { opacity: 1 !important; }
    .gaba__drug { opacity: 1 !important; }
    .gaba__shield { opacity: 1 !important; }
    .gaba__resolved { opacity: 1 !important; }
    .gaba__inflam { opacity: 0 !important; }
    .gaba__dock-dot { opacity: 0 !important; }
  }
</style>
