---
// ViralVectorVaccine.astro — schematic, self-contained SVG + CSS animation of how
// an adenovirus-vector COVID vaccine (e.g. 克威莎 / Ad5-nCoV) uses a modified,
// replication-deficient adenovirus as a "delivery van" to carry the spike-protein
// gene into a cell, so the cell makes spike-protein fragments the immune system
// learns to recognise and defend against (需求 4, 13). SCHEMATIC labelled shapes,
// inline SVG + scoped CSS, NO JavaScript. Five storyboard steps cycle on a shared
// 15s timeline (3s each). Under prefers-reduced-motion all motion stops and the
// diagram freezes.
interface Props {
  alt?: string;
  caption?: string;
  subject?: string;
}

const {
  alt = '动画演示腺病毒载体把刺突蛋白基因送进细胞,细胞造出刺突蛋白片段,免疫系统据此产生抗体、获得保护。',
  subject,
} = Astro.props;

const steps = [
  '疫苗用"改装腺病毒"当快递车,装着刺突蛋白基因',
  '快递车把基因送进细胞(载体不能繁殖)',
  '细胞照着基因造出病毒刺突蛋白片段',
  '免疫系统认出这个"外来零件"、产生抗体',
  '真病毒来袭,身体能更快识别清除',
];
---

<div class="vvv">
  <svg class="vvv__svg" viewBox="0 0 360 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>{alt}</title>

    <rect class="vvv__cell" x="20" y="150" width="320" height="72" rx="22" />
    <text class="vvv__t vvv__t--organ" x="36" y="196" text-anchor="start">人体细胞</text>
    <rect class="vvv__receptor" x="196" y="132" width="24" height="24" rx="3" />
    <text class="vvv__t vvv__t--small" x="208" y="126" text-anchor="middle">细胞的"蛋白工厂"</text>

    <g class="vvv__inflam">
      <polygon points="208,74 216,96 238,96 220,110 228,132 208,118 188,132 196,110 178,96 200,96" />
      <text class="vvv__t vvv__t--inflam" x="208" y="66" text-anchor="middle">刺突蛋白片段</text>
    </g>

    <g class="vvv__dots">
      <circle class="vvv__lig" cx="70" cy="52" r="10" />
      <circle class="vvv__lig" cx="118" cy="36" r="10" />
      <circle class="vvv__lig" cx="96" cy="82" r="10" />
      <text class="vvv__t vvv__t--small" x="96" y="16" text-anchor="middle">腺病毒载体(快递车)</text>
    </g>

    <circle class="vvv__dock-dot" cx="208" cy="140" r="9" />

    <g class="vvv__drug">
      <rect class="vvv__pill" x="192" y="138" width="32" height="16" rx="8" />
      <text class="vvv__t vvv__t--drug" x="208" y="232" text-anchor="middle">{subject ?? '腺病毒载体疫苗'}</text>
    </g>

    <g class="vvv__shield">
      <path d="M186 128 l22 -8 l22 8 v14 q0 16 -22 24 q-22 -8 -22 -24 z" />
      <text class="vvv__t vvv__t--shield" x="208" y="150" text-anchor="middle">免疫识别</text>
    </g>

    <g class="vvv__resolved">
      <rect x="200" y="30" width="150" height="30" rx="15" />
      <text class="vvv__t vvv__t--resolved" x="275" y="50" text-anchor="middle">产生抗体 · 获得保护</text>
    </g>
  </svg>

  <ol class="vvv__steps" aria-label="作用步骤">
    {steps.map((step) => (
      <li class="vvv__step">{step}</li>
    ))}
  </ol>
</div>

<style>
  .vvv {
    --dur: 15s;
    display: grid;
    gap: 0.85rem;
    max-width: 30rem;
    margin-inline: auto;
  }
  .vvv__svg { width: 100%; height: auto; font-family: inherit; background: #f8fafc; border-radius: 12px; }
  .vvv__cell { fill: #fef2f2; stroke: #fca5a5; stroke-width: 2; }
  .vvv__receptor { fill: #64748b; }
  .vvv__t { fill: #1e293b; font-size: 13px; }
  .vvv__t--organ { fill: #475569; font-size: 12px; }
  .vvv__t--small { font-size: 11px; fill: #475569; }
  .vvv__t--inflam { fill: #6d28d9; font-size: 11px; font-weight: 700; }
  .vvv__t--drug { fill: #0f766e; font-size: 12px; font-weight: 600; }
  .vvv__t--shield { fill: #1d4ed8; font-size: 11px; font-weight: 700; }
  .vvv__t--resolved { fill: #15803d; font-size: 12px; font-weight: 700; }
  .vvv__lig { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; }
  .vvv__dots { animation: vvv-drift var(--dur) infinite; }
  .vvv__inflam polygon { fill: #ddd6fe; stroke: #7c3aed; stroke-width: 1.5; }
  .vvv__inflam { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vvv-inflame var(--dur) infinite; }
  .vvv__dock-dot { fill: #fb7185; stroke: #be123c; stroke-width: 1.5; opacity: 0; animation: vvv-dock var(--dur) infinite; }
  .vvv__pill { fill: #99f6e4; stroke: #0f766e; stroke-width: 2.5; }
  .vvv__drug { opacity: 0; animation: vvv-bind var(--dur) infinite; }
  .vvv__shield path { fill: #dbeafe; stroke: #2563eb; stroke-width: 2; }
  .vvv__shield { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vvv-pop var(--dur) infinite; }
  .vvv__resolved rect { fill: #dcfce7; stroke: #22c55e; stroke-width: 2; }
  .vvv__resolved { opacity: 0; transform-box: fill-box; transform-origin: center; animation: vvv-pop-late var(--dur) infinite; }
  .vvv__steps { counter-reset: vvvstep; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .vvv__step { position: relative; padding: 0.4rem 0.6rem 0.4rem 2.5rem; border-radius: 8px; font-size: 0.9rem; line-height: 1.4; color: #334155; background: transparent; transform-origin: left center; animation: vvv-step var(--dur) infinite; }
  .vvv__step::before { counter-increment: vvvstep; content: counter(vvvstep); position: absolute; left: 0.5rem; top: 0.4rem; width: 1.5rem; height: 1.5rem; border-radius: 999px; background: #e2e8f0; color: #0f172a; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; animation: vvv-badge var(--dur) infinite; }
  .vvv__step:nth-child(1), .vvv__step:nth-child(1)::before { animation-delay: 0s; }
  .vvv__step:nth-child(2), .vvv__step:nth-child(2)::before { animation-delay: 3s; }
  .vvv__step:nth-child(3), .vvv__step:nth-child(3)::before { animation-delay: 6s; }
  .vvv__step:nth-child(4), .vvv__step:nth-child(4)::before { animation-delay: 9s; }
  .vvv__step:nth-child(5), .vvv__step:nth-child(5)::before { animation-delay: 12s; }
  @keyframes vvv-drift { 0% { transform: translate(0,0);} 10% { transform: translate(6px,4px);} 20% { transform: translate(-4px,2px);} 40%,100% { transform: translate(0,0);} }
  @keyframes vvv-dock { 0%,20% { opacity:0;} 26%,40% { opacity:1;} 46%,100% { opacity:0;} }
  @keyframes vvv-inflame { 0%,16% { opacity:0; transform: scale(0.6);} 24% { opacity:1; transform: scale(1.1);} 30%,74% { opacity:1; transform: scale(1);} 84%,100% { opacity:0; transform: scale(0.6);} }
  @keyframes vvv-bind { 0%,36% { opacity:0; transform: translateY(28px);} 44% { opacity:1; transform: translateY(-4px);} 50%,100% { opacity:1; transform: translateY(0);} }
  @keyframes vvv-pop { 0%,60% { opacity:0; transform: scale(0);} 66% { opacity:1; transform: scale(1.25);} 71%,100% { opacity:1; transform: scale(1);} }
  @keyframes vvv-pop-late { 0%,78% { opacity:0; transform: scale(0);} 84% { opacity:1; transform: scale(1.2);} 89%,100% { opacity:1; transform: scale(1);} }
  @keyframes vvv-step { 0%,17% { opacity:1; color:#0f766e; font-weight:700; background:#f0fdfa; transform: scale(1.02);} 20%,100% { opacity:0.5; color:#334155; font-weight:400; background:transparent; transform: scale(1);} }
  @keyframes vvv-badge { 0%,17% { background:#0f766e; color:#fff; transform: scale(1.15);} 20%,100% { background:#e2e8f0; color:#0f172a; transform: scale(1);} }
  @media (prefers-reduced-motion: reduce) {
    .vvv *, .vvv__svg * { animation: none !important; transition: none !important; transform: none !important; }
    .vvv__step, .vvv__step::before { animation: none !important; transform: none !important; }
    .vvv__step { opacity: 1 !important; }
    .vvv__drug { opacity: 1 !important; }
    .vvv__shield { opacity: 1 !important; }
    .vvv__resolved { opacity: 1 !important; }
    .vvv__inflam { opacity: 0 !important; }
    .vvv__dock-dot { opacity: 0 !important; }
  }
</style>
